<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>RUGCIRCUS — Rewards</title>
<meta name="description" content="Earn RUGCIRCUS Reward Points by completing community tasks, sponsored offers and social raids.">
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<script src="https://w.tads.me/widget.js"></script>
<style>
:root{color-scheme:dark;--bg:#07060b;--panel:#11101a;--panel2:#171320;--line:rgba(255,255,255,.08);--text:#fffaff;--muted:#a99db8;--hot:#ff3d87;--pink:#ff68b0;--violet:#8d63ff;--gold:#ffc857;--green:#55e6a5;--cyan:#55d8ff}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}body{overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(circle at 8% 0,rgba(255,61,135,.14),transparent 27%),radial-gradient(circle at 92% 8%,rgba(141,99,255,.16),transparent 30%),radial-gradient(circle at 50% 100%,rgba(255,200,87,.05),transparent 30%)}
a{text-decoration:none;color:inherit}button{font:inherit;cursor:pointer}.app{min-height:100vh;position:relative}.top{min-height:76px;padding:0 30px;display:flex;align-items:center;justify-content:space-between;gap:18px;border-bottom:1px solid var(--line);background:rgba(7,6,11,.82);backdrop-filter:blur(22px);position:sticky;top:0;z-index:20}.brand{display:flex;align-items:center;gap:12px;font-weight:950;letter-spacing:.05em}.logo{width:42px;height:42px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(135deg,var(--hot),var(--violet));box-shadow:0 0 35px rgba(255,61,135,.28)}.brand small{display:block;color:#8f829e;font-size:10px;letter-spacing:.22em;margin-top:2px}.back{border:1px solid var(--line);background:rgba(255,255,255,.04);padding:11px 14px;border-radius:12px;color:#fff;font-weight:900;font-size:12px}
.wrap{width:min(1180px,calc(100% - 36px));margin:auto;padding:34px 0 70px}.hero{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;margin-bottom:18px}.eyebrow{font-size:11px;font-weight:950;letter-spacing:.2em;color:var(--gold);text-transform:uppercase}.hero h1{font-size:clamp(42px,7vw,72px);line-height:.9;letter-spacing:-.065em;margin:12px 0}.hero h1 span{background:linear-gradient(90deg,#fff,var(--pink),var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent}.hero p{max-width:720px;color:var(--muted);line-height:1.65;margin:0}.scoreBox{min-width:210px;padding:18px;border:1px solid rgba(255,200,87,.2);border-radius:20px;background:linear-gradient(145deg,rgba(255,200,87,.08),rgba(141,99,255,.08));text-align:right}.scoreBox strong{display:block;font-size:34px}.scoreBox span{color:#91859d;font-size:10px;font-weight:900;letter-spacing:.14em}
.join{padding:18px;border:1px solid rgba(141,99,255,.28);border-radius:20px;background:linear-gradient(135deg,rgba(141,99,255,.12),rgba(255,61,135,.06));margin-bottom:18px}.joinTop{display:flex;align-items:center;justify-content:space-between;gap:15px}.join h2{margin:5px 0 4px;font-size:22px}.join p{margin:0;color:var(--muted);font-size:13px;line-height:1.5}.joinBtn{border:1px solid rgba(255,104,176,.4);background:linear-gradient(135deg,#8b174e,#7040c4);color:#fff;padding:12px 16px;border-radius:12px;font-weight:950;white-space:nowrap}.status{margin-top:12px;padding:10px 12px;border:1px solid var(--line);border-radius:11px;background:rgba(0,0,0,.18);color:#9d91a8;font-size:12px}.status.good{color:var(--green);border-color:rgba(85,230,165,.2)}
.sectionHead{display:flex;align-items:flex-end;justify-content:space-between;gap:15px;margin:30px 0 12px}.sectionHead h2{font-size:25px;margin:5px 0}.sectionHead p{color:var(--muted);font-size:12px;margin:0}
.tasks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.task{position:relative;padding:19px;border:1px solid var(--line);border-radius:19px;background:linear-gradient(145deg,#15111e,#0d0a12);box-shadow:0 18px 50px rgba(0,0,0,.18);overflow:hidden}.task:after{content:"";position:absolute;width:150px;height:150px;right:-80px;top:-80px;border-radius:50%;background:radial-gradient(circle,rgba(255,61,135,.18),transparent 68%);pointer-events:none}.taskHead{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.taskIcon{width:42px;height:42px;border-radius:13px;display:grid;place-items:center;background:linear-gradient(135deg,#2b183e,#5b255d);font-size:19px}.task h3{margin:0 0 5px;font-size:17px}.task p{margin:0;color:var(--muted);font-size:12px;line-height:1.55}.points{color:var(--gold);font-weight:950;white-space:nowrap;font-size:13px}.taskBody{display:flex;gap:11px;margin-top:16px}.taskBtn{flex:1;min-height:44px;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.15;border:1px solid rgba(255,255,255,.1);border-radius:11px;background:linear-gradient(135deg,#21172d,#34204a);color:#fff;font-size:11px;font-weight:950}.taskBtn.hot{background:linear-gradient(135deg,#8b174e,#d93478);border-color:rgba(255,61,135,.45)}.taskBtn.green{background:linear-gradient(135deg,#103b31,#16765d);border-color:rgba(85,230,165,.3)}.taskBtn.blue{background:linear-gradient(135deg,#12415b,#167ca3);border-color:rgba(85,216,255,.3)}.taskBtn:disabled{opacity:.5;cursor:not-allowed}
.raids{display:grid;gap:13px}.raid{border:1px solid var(--line);border-radius:20px;background:linear-gradient(145deg,#17101f,#0c0911);overflow:hidden}.raidTop{padding:17px 18px 0;display:flex;justify-content:space-between;gap:15px}.raid h3{margin:5px 0;font-size:21px}.raidCopy{color:var(--muted);font-size:12px;line-height:1.5}.raidImage{height:150px;margin-top:15px;background:#09070d;display:grid;place-items:center;overflow:hidden}.raidImage img{width:100%;height:100%;object-fit:cover}.raidImage span{color:#796d86;font-weight:950;letter-spacing:.12em}.raidActions{padding:15px 18px 18px;display:grid;grid-template-columns:1fr 1fr;gap:9px}.raidActions .full{grid-column:1/-1}.raidNote{padding:0 18px;color:#ffc857;font-size:11px;font-weight:900;line-height:1.5}.claim{background:linear-gradient(135deg,#8b174e,#d93478)!important;border-color:rgba(255,61,135,.5)!important}
.leader{margin-top:30px;padding:20px;border:1px solid var(--line);border-radius:20px;background:linear-gradient(145deg,#15111d,#0c0911)}.leaderHead{display:flex;justify-content:space-between;gap:15px;align-items:center}.leaderHead h2{margin:5px 0}.pool{color:var(--gold);font-size:11px;font-weight:950}.table{margin-top:14px;border:1px solid rgba(255,255,255,.06);border-radius:13px;overflow:hidden}.row{display:grid;grid-template-columns:36px minmax(100px,1fr) minmax(70px,auto) auto;gap:10px;padding:12px 13px;border-bottom:1px solid rgba(255,255,255,.05);align-items:center;font-size:12px}.row:last-child{border-bottom:0}.head{color:#756a7f;font-size:9px;text-transform:uppercase;font-weight:950;letter-spacing:.1em;background:rgba(255,255,255,.02)}.rank{color:var(--gold);font-weight:950}.row span:nth-child(3){color:#7e7389;font-family:ui-monospace,monospace;font-size:10px}.row strong{color:var(--green)}
.tadsWrap{margin-top:22px;padding:16px;border:1px solid rgba(255,255,255,.08);border-radius:20px;background:linear-gradient(145deg,rgba(255,255,255,.035),rgba(141,99,255,.045));overflow:hidden}.tadsHead{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:10px}.tadsHead h3{margin:3px 0 0;font-size:16px}.tadsLabel{font-size:9px;font-weight:950;letter-spacing:.16em;color:#8f829e}.tadsStatus{font-size:10px;color:#756a7f}.tadsAd{min-height:72px}.tadsAd:empty{min-height:0}.note{margin-top:15px;color:#756a7f;font-size:10px;line-height:1.6}
@media(max-width:760px){.top{padding:10px 15px}.wrap{width:min(100% - 24px,700px);padding-top:22px}.hero{align-items:stretch;flex-direction:column}.scoreBox{text-align:left}.tasks{grid-template-columns:1fr}.joinTop{align-items:stretch;flex-direction:column}.joinBtn{width:100%}.raidActions{grid-template-columns:1fr}.raidActions .full{grid-column:auto}.row{grid-template-columns:30px minmax(80px,1fr) auto}.row span:nth-child(3){display:none}}
</style>
</head>
<body>
<div class="app">
<header class="top"><div class="brand"><div class="logo">🎪</div><div>RUGCIRCUS<small>REWARDS</small></div></div><a class="back" href="/">← COMMAND CENTER</a></header>
<main class="wrap">
<section class="hero">
<div><div class="eyebrow">🎪 REWARD WALL</div><h1>EARN <span>POINTS.</span></h1><p>Complete real community tasks, open sponsored offers and join live raids. Every task shows its exact point value before you start.</p></div>
<div class="scoreBox"><strong id="myPoints">—</strong><span>YOUR POINTS</span></div>
</section>

<section class="join">
<div class="joinTop"><div><div class="eyebrow">LEADERBOARD ACCESS</div><h2>Join the Reward Wall</h2><p>Telegram identifies you. Telegram identifies you automatically. Join once to start earning points. A wallet can be added later when rewards are distributed.</p></div><button class="joinBtn" id="joinBtn">JOIN REWARDS</button></div>
<div class="status" id="joinStatus">Checking your Telegram session…</div>
</section>

<div class="sectionHead"><div><div class="eyebrow">COMMUNITY TASKS</div><h2>Complete & Earn</h2><p>One-time or daily limits are shown on each task.</p></div></div>
<section class="tasks">
<article class="task"><div class="taskHead"><div style="display:flex;gap:12px"><div class="taskIcon">𝕏</div><div><h3>Follow RUGCIRCUS on X</h3><p>Follow <b>@RugCircusX</b> on X to earn your +2 points.</p></div></div><span class="points">+2</span></div><div class="taskBody"><a class="taskBtn hot" href="https://x.com/RugCircusX" target="_blank" rel="noopener">OPEN X ↗</a><button class="taskBtn" data-task="x_follow">CLAIM +2</button></div><div class="taskMeta">REQUIRED: FOLLOW @RugCircusX · One reward · X follow is not API-verified yet.</div></article>

<article class="task"><div class="taskHead"><div style="display:flex;gap:12px"><div class="taskIcon">✈️</div><div><h3>Join RUGCIRCUS Telegram</h3><p>Join the official <b>@rugcxx</b> community group.</p></div></div><span class="points">+2</span></div><div class="taskBody"><a class="taskBtn blue" href="https://t.me/rugcxx" target="_blank" rel="noopener">JOIN GROUP ↗</a><button class="taskBtn" data-task="telegram_group">VERIFY +2</button></div><div class="taskMeta">REQUIRED: JOIN THE GROUP · Membership is checked through Telegram.</div></article>

<article class="task"><div class="taskHead"><div style="display:flex;gap:12px"><div class="taskIcon">💰</div><div><h3>Monetag Offer</h3><p>Open the sponsored offer and complete the visit.</p></div></div><span class="points">+2</span></div><div class="taskBody"><a class="taskBtn green" id="monetagBtn" href="/api/sponsor/click" target="_blank" rel="noopener">OPEN OFFER ↗</a></div><div class="taskMeta">REQUIRED: OPEN THE OFFER · Up to 3 valid offers per 24 hours.</div></article>

<article class="task"><div class="taskHead"><div style="display:flex;gap:12px"><div class="taskIcon">🤖</div><div><h3>Add the RUGCIRCUS Bot to a Group</h3><p>Add <b>@RugcircusRaidBot</b> to a Telegram group.</p></div></div><span class="points">+3</span></div><div class="taskBody"><a class="taskBtn" href="https://t.me/RugcircusRaidBot?startgroup=true" target="_blank" rel="noopener">ADD BOT ↗</a><button class="taskBtn" data-task="bot_group">CHECK +3</button></div><div class="taskMeta">REQUIRED: ADD @RugcircusRaidBot TO A GROUP · Reward is granted when detected.</div></article>
</section>

<section class="tadsWrap" id="tadsWrap">
<div class="tadsHead"><div><div class="tadsLabel">SPONSORED</div><h3>Community Sponsor</h3></div><span class="tadsStatus" id="tadsStatus">Loading sponsor…</span></div>
<div class="tadsAd" id="tads-container-12484"></div>
</section>

<div class="sectionHead"><div><div class="eyebrow">⚔️ LIVE RAIDS</div><h2>Raid for +3</h2><p>Every eligible raid is worth 3 points once per raid.</p></div></div>
<section class="raids" id="raids"><div class="status">Loading live raids…</div></section>

<section class="leader"><div class="leaderHead"><div><div class="eyebrow">LIVE RANKING</div><h2>Top Raiders</h2></div><span class="pool" id="pool">Reward pool loading…</span></div><div class="table" id="leaderboard"><div class="status">Loading leaderboard…</div></div><div class="note">Raid points require the X raid link to be opened first. Like, repost and comment are required community actions; X engagement itself is not automatically verified until X API verification is added.</div></section>
</main>
</div>
<script>
const TOKEN_KEY="rugcircus_leaderboard_token";
let tg=null,telegramInitData="",telegramUser=null,memberToken=localStorage.getItem(TOKEN_KEY)||"";
const $=id=>document.getElementById(id);
function telegram(){return window.Telegram?.WebApp||null}
function toast(s){alert(s)}
function auth(){return telegramInitData?{"x-telegram-init-data":telegramInitData}:{}}
function initTelegram(){tg=telegram();if(tg){tg.ready();tg.expand();telegramInitData=tg.initData||"";telegramUser=tg.initDataUnsafe?.user||null}}
async function join(){
  if(!telegramInitData||!telegramUser){
    $("joinStatus").className="status";
    $("joinStatus").textContent="Open RUGCIRCUS from Telegram to join Rewards.";
    return;
  }
  const button=$("joinBtn");
  button.disabled=true;
  try{
    const username=String(telegramUser.username||("tg_"+telegramUser.id)).replace(/^@/,"");
    const r=await fetch("/api/leaderboard/join",{
      method:"POST",
      headers:{"content-type":"application/json",...auth()},
      body:JSON.stringify({username,memberToken,telegramInitData})
    });
    const d=await r.json().catch(()=>({}));
    if(!r.ok||!d.ok)throw new Error(d.error||"Could not join Reward Wall");
    memberToken=String(d.memberToken||memberToken);
    if(memberToken)localStorage.setItem(TOKEN_KEY,memberToken);
    updateMonetag();
    localStorage.setItem("rugcircus_leaderboard_username",d.member.username);
    $("joinStatus").className="status good";
    $("joinStatus").textContent="✓ Rewards joined · @"+String(d.member.username).replace(/^@/,"");
    button.textContent="JOINED";
    await refresh();
  }catch(e){
    $("joinStatus").className="status";
    $("joinStatus").textContent=e.message||"Could not join Reward Wall";
  }finally{
    button.disabled=false;
  }
}
function updateMonetag(){const a=$("monetagBtn");if(a)a.href=memberToken?"/api/sponsor/click?memberToken="+encodeURIComponent(memberToken):"/api/sponsor/click"}
function updateIdentity(){
  if(!telegramInitData||!telegramUser){
    $("joinStatus").className="status";
    $("joinStatus").textContent="Open RUGCIRCUS from Telegram to join Rewards.";
    $("joinBtn").textContent="OPEN IN TELEGRAM";
    updateMonetag();
    return;
  }
  if(memberToken){
    $("joinStatus").className="status good";
    $("joinStatus").textContent="✓ Telegram account detected · Reward Wall membership found";
    $("joinBtn").textContent="JOINED";
  }else{
    $("joinStatus").className="status good";
    $("joinStatus").textContent="✓ Telegram account detected · tap Join Rewards to opt in";
    $("joinBtn").textContent="JOIN REWARDS";
  }
  updateMonetag();
}
async function taskClaim(task){if(!memberToken){toast("Join the Reward Wall first.");return}const b=document.querySelector('[data-task="'+task+'"]');if(b)b.disabled=true;try{const r=await fetch("/api/rewards/task",{method:"POST",headers:{"content-type":"application/json",...auth()},body:JSON.stringify({memberToken,task})}),d=await r.json().catch(()=>({}));if(!r.ok||!d.ok)throw new Error(d.error||"Task could not be verified");toast(d.awarded?"Reward added: +"+d.points+" points":"Task already completed");await refresh()}catch(e){toast(e.message||"Task unavailable")}finally{if(b)b.disabled=false}}
async function loadRaids(){const el=$("raids");try{const r=await fetch("/api/campaigns?live="+Date.now(),{cache:"no-store"}),d=await r.json();if(!d.ok)throw new Error();const rows=(d.campaigns||[]).filter(x=>String(x.status||"").toLowerCase()==="active");if(!rows.length){el.innerHTML='<div class="status">No active raids right now.</div>';return}el.innerHTML=rows.map(x=>{const img=x.logo_url?'<img src="'+String(x.logo_url).replace(/"/g,"&quot;")+'" alt="" loading="lazy">':'<span>⚔️ RUGCIRCUS RAID</span>';return '<article class="raid"><div class="raidTop"><div><div class="eyebrow">LIVE RAID</div><h3>$'+String(x.ticker||"TOKEN")+' · '+String(x.name||"Campaign")+'</h3><div class="raidCopy">'+String(x.raid_copy||"Complete the social raid actions to earn points.")+'</div></div><span class="points">+3</span></div><div class="raidImage">'+img+'</div><div class="raidNote">⚠️ REQUIRED: LIKE ❤️ · COMMENT 💬 · REPOST 🔁 on X before claiming your +3 points.</div><div class="raidActions"><a class="taskBtn hot raidXLink" data-base-url="/api/raid/click?campaign='+Number(x.id)+'&platform=x" href="/api/raid/click?campaign='+Number(x.id)+'&platform=x" target="_blank" rel="noopener">𝕏 OPEN X RAID</a><button class="taskBtn claim full" data-raid="'+Number(x.id)+'">CLAIM RAID +3</button></div></article>'}).join("");el.querySelectorAll(".raidXLink").forEach(a=>{a.href=a.dataset.baseUrl+"&memberToken="+encodeURIComponent(memberToken)});el.querySelectorAll("[data-raid]").forEach(b=>b.addEventListener("click",()=>claimRaid(Number(b.dataset.raid))))}catch{el.innerHTML='<div class="status">Live raids are unavailable right now.</div>'}}
async function claimRaid(id){if(!memberToken){toast("Join the Reward Wall first.");return}try{const r=await fetch("/api/raid/complete",{method:"POST",headers:{"content-type":"application/json",...auth()},body:JSON.stringify({memberToken,campaignId:id})}),d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||"Open the X raid first, complete the actions, then claim.");toast(d.awarded?"+3 raid points added.":d.message||"Raid already completed.");await refresh()}catch(e){toast(e.message||"Raid could not be completed")}}
async function refresh(){try{const r=await fetch("/api/rewards?memberToken="+encodeURIComponent(memberToken),{cache:"no-store"}),d=await r.json();if(d.ok){const me=d.me;if(me){memberToken=memberToken||me.memberToken;$("myPoints").textContent=Number(me.points||0)+" pts"}$("pool").textContent="Reward pool "+Number(d.rewardPoolGram||0).toFixed(3)+" GRAM";const rows=d.leaderboard||[];$("leaderboard").innerHTML='<div class="row head"><span>#</span><b>RAIDER</b><span>WALLET</span><strong>POINTS</strong></div>'+(rows.length?rows.map((x,i)=>'<div class="row"><span class="rank">'+(i<3?["🥇","🥈","🥉"][i]:i+1)+'</span><b>@'+String(x.username||"Anonymous")+'</b><span>'+String(x.wallet||"—")+'</span><strong>'+Number(x.points||0)+" pts</strong></div>").join(""):'<div class="status">No raiders have joined yet.</div>')}}catch{}await loadRaids()}
$("joinBtn").addEventListener("click",join);document.querySelectorAll("[data-task]").forEach(b=>b.addEventListener("click",()=>taskClaim(b.dataset.task)));
function initTads(){
  const wrap=$("tadsWrap"),status=$("tadsStatus");
  if(!wrap||!status)return;
  const hide=()=>{wrap.style.display="none"};
  const showError=()=>{status.textContent="Sponsor unavailable";setTimeout(hide,1500)};
  const init=()=>{
    try{
      if(!window.tads||typeof window.tads.init!=="function"){showError();return}
      const adController=window.tads.init({
        widgetId:"12484",
        type:"static",
        debug:false,
        onAdsNotFound:hide
      });
      if(!adController||typeof adController.loadAd!=="function"){showError();return}
      const timeout=new Promise((_,reject)=>setTimeout(()=>reject(new Error("TADS timeout")),8000));
      Promise.race([adController.loadAd(),timeout])
        .then(()=>{
          status.textContent="Sponsored";
          return adController.showAd();
        })
        .catch((err)=>{
          console.warn("TADS:",err);
          hide();
        });
    }catch(err){
      console.warn("TADS init:",err);
      hide();
    }
  };
  if(window.tads&&typeof window.tads.init==="function")init();
  else{
    const started=performance.now();
    const iv=setInterval(()=>{
      if(window.tads&&typeof window.tads.init==="function"){
        clearInterval(iv);
        init();
      }else if(performance.now()-started>5000){
        clearInterval(iv);
        hide();
      }
    },100);
  }
}
async function boot(){initTelegram();updateIdentity();initTads();await refresh()}boot();
</script>
</body>
</html>