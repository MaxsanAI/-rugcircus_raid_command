---
export const prerender = false;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#100b18">
<title>RUGCIRCUS Rewards</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<script src="//libtl.com/sdk.js" data-zone="11992205" data-sdk="show_11992205"></script>
<style>
:root{color-scheme:dark;--bg:#100b18;--panel:#1a1225;--line:#382642;--text:#fff7ff;--muted:#b8a8c5;--pink:#ff438d;--gold:#ffc857;--green:#63e6be}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 20% 0%,#352044 0,transparent 42%),var(--bg);color:var(--text);font:16px/1.5 Inter,system-ui,-apple-system,Segoe UI,sans-serif;min-height:100vh}.wrap{width:min(760px,100%);margin:auto;padding:20px 16px 48px}.top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:4px 0 20px}.brand{font-weight:950;letter-spacing:.08em}.brand small{display:block;color:var(--muted);font-size:10px;letter-spacing:.2em}.back{color:var(--text);text-decoration:none;border:1px solid var(--line);padding:9px 12px;border-radius:12px}.hero,.panel{border:1px solid var(--line);background:linear-gradient(145deg,rgba(42,27,55,.97),rgba(22,15,31,.97));border-radius:20px;padding:20px;margin-bottom:14px;box-shadow:0 18px 45px #0002}.eyebrow{font-size:11px;font-weight:900;letter-spacing:.17em;color:var(--gold)}h1{font-size:clamp(28px,7vw,42px);line-height:1.04;margin:9px 0 10px;letter-spacing:-.04em}h1 span{color:var(--pink)}p{color:var(--muted);margin:8px 0 14px}.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:17px}.stat{padding:12px;border-radius:14px;background:#0e0915;border:1px solid #30213a}.stat strong{display:block;font-size:21px}.stat span{font-size:11px;color:var(--muted)}h2{font-size:19px;margin:0 0 12px}.row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #30213a}.row:last-child{border-bottom:0}.row b{display:block}.row small{display:block;color:var(--muted);font-size:12px}.btn{border:0;border-radius:12px;padding:12px 14px;font-weight:900;color:#180d1e;background:linear-gradient(100deg,var(--gold),#ff8c6b);cursor:pointer;white-space:nowrap}.btn.pink{background:linear-gradient(100deg,var(--pink),#a477ff);color:white}.btn.ghost{background:#21162c;color:var(--text);border:1px solid var(--line)}.btn:disabled{opacity:.5;cursor:wait}.field{width:100%;padding:13px;border-radius:12px;border:1px solid var(--line);background:#100b18;color:var(--text);font:inherit;margin:5px 0 10px}.status{font-size:13px;color:var(--muted);margin-top:10px;overflow-wrap:anywhere}.good{color:var(--green)}.leader{display:grid;grid-template-columns:28px minmax(0,1fr) auto;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid #30213a}.leader:last-child{border-bottom:0}.leader span{color:var(--gold);font-weight:900}.leader small{color:var(--muted)}.fine{font-size:11px;color:#8e7b9d;margin-top:12px}@media(max-width:420px){.wrap{padding:13px 11px 34px}.hero,.panel{padding:16px;border-radius:17px}.row{align-items:flex-start}.row .btn{font-size:12px;padding:10px}.stats{gap:6px}.stat{padding:10px 8px}.stat strong{font-size:18px}.stat span{font-size:10px}}
</style>
</head>
<body>
<main class="wrap">
<header class="top"><div class="brand">🎪 RUGCIRCUS<small>REWARD WALL</small></div><a class="back" href="/">← Command Center</a></header>
<section class="hero"><div class="eyebrow">COMMUNITY REWARDS · $RUGCX</div><h1>PLAY YOUR PART.<br><span>EARN POINTS.</span></h1><p>Complete community tasks or watch a rewarded ad to earn points on the RUGCIRCUS leaderboard. Open this page inside Telegram so your account can be verified.</p><div class="stats"><div class="stat"><strong id="myPoints">—</strong><span>YOUR POINTS</span></div><div class="stat"><strong id="adCount">0/2</strong><span>ADS TODAY</span></div><div class="stat"><strong id="members">—</strong><span>RAIDERS</span></div></div><div id="status" class="status">Connecting to Telegram…</div></section>
<section class="panel"><h2>🔐 Join the Reward Wall</h2><p>Join with your Telegram account. A TON wallet is optional for joining and earning points.</p><label for="username">Leaderboard username</label><input id="username" class="field" maxlength="32" placeholder="Your Telegram username"><button id="join" class="btn pink">JOIN / SYNC ACCOUNT</button><div id="memberStatus" class="status">Your membership will appear here.</div></section>
<section class="panel"><h2>🎬 Rewarded Interstitial</h2><div class="row"><div><b>Watch a full ad</b><small>First completed ad: +3 points · second: +2 points</small></div><button id="watchAd" class="btn" disabled>WATCH AD · +3</button></div><div class="status" id="adStatus">Join the Reward Wall first.</div><div class="fine">The points are credited only after the rewarded-ad SDK reports completion and the server accepts the reward.</div></section>
<section class="panel"><h2>⚡ Community Tasks</h2>
<div class="row"><div><b>Follow RUGCIRCUS on X</b><small>One-time reward · +2 points</small></div><button class="btn ghost task" data-task="x_follow">VERIFY +2</button></div>
<div class="row"><div><b>Join the Telegram group</b><small>Membership check · +2 points</small></div><button class="btn ghost task" data-task="telegram_group">VERIFY +2</button></div>
<div class="row"><div><b>Add the raid bot to a group</b><small>Bot must receive the group update · +3 points</small></div><button class="btn ghost task" data-task="bot_group">VERIFY +3</button></div>
<div id="taskStatus" class="status">Complete each task once.</div></section>
<section class="panel"><h2>🏆 Live Leaderboard</h2><div id="leaderboard"><div class="status">Loading leaderboard…</div></div><div class="fine">Points are community activity points, not a guaranteed cash or token payout.</div></section>
</main>
<script>
const tg=window.Telegram?.WebApp;try{tg?.ready();tg?.expand()}catch{}
const TOKEN_KEY="rugcircus_leaderboard_token";
let initData=String(tg?.initData||localStorage.getItem("rugcircus_telegram_init_data")||"");
let user=tg?.initDataUnsafe?.user||null;
let memberToken=localStorage.getItem(TOKEN_KEY)||"";
const $=id=>document.getElementById(id);
function headers(){return {"content-type":"application/json","x-telegram-init-data":initData}}
function msg(id,text,good=false){$(id).textContent=text;$(id).classList.toggle("good",good)}
function escapeHtml(v){return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]))}
async function api(url,opts={}){const r=await fetch(url,{cache:"no-store",...opts});const d=await r.json().catch(()=>({}));if(!r.ok||d.ok===false)throw new Error(d.error||("Request failed ("+r.status+")"));return d}
function identityReady(){if(user){$("username").value=user.username||("tg_"+user.id);msg("status","Telegram connected as "+(user.username?"@"+user.username:user.first_name||user.id),true)}else{msg("status","Open this page from the Telegram bot’s Rewards button. Telegram verification is required.")}}
async function join(){if(!initData||!user){msg("memberStatus","Open Rewards from inside Telegram to verify your account.");return}const username=String($("username").value||user.username||("tg_"+user.id)).trim().replace(/^@/,"");$("join").disabled=true;msg("memberStatus","Joining Reward Wall…");try{const d=await api("/api/leaderboard/join",{method:"POST",headers:headers(),body:JSON.stringify({username,telegramInitData:initData})});memberToken=d.memberToken;localStorage.setItem(TOKEN_KEY,memberToken);localStorage.setItem("rugcircus_leaderboard_username",d.member.username);msg("memberStatus","✓ Joined as @"+d.member.username+" · "+Number(d.member.points||0)+" points",true);await refresh()}catch(e){msg("memberStatus",e.message)}finally{$("join").disabled=false}}
async function refresh(){try{const d=await api("/api/rewards");$("members").textContent=Number(d.leaderboardMembers||0);$("leaderboard").innerHTML=(d.leaderboard||[]).length?(d.leaderboard||[]).map((x,i)=>'<div class="leader"><span>'+(["🥇","🥈","🥉"][i]||String(i+1))+'</span><div><b>@'+escapeHtml(x.username||"raider")+'</b><small> '+escapeHtml(x.wallet||"Telegram member")+'</small></div><strong>'+Number(x.points||0)+' pts</strong></div>').join(""):'<div class="status">No raiders yet. Join first.</div>';if(memberToken){const mine=(d.leaderboard||[]).find(x=>String(x.username||"").toLowerCase()===String($("username").value||"").replace(/^@/,"").toLowerCase());if(mine)$("myPoints").textContent=Number(mine.points||0);$("watchAd").disabled=false;msg("adStatus","Ready · watch a complete rewarded ad.",true);try{const st=await api("/api/adsgram/reward?status=1&memberToken="+encodeURIComponent(memberToken));$("adCount").textContent=Number(st.rewardedToday||0)+"/2";$("watchAd").textContent=Number(st.rewardedToday||0)===0?"WATCH AD · +3":"WATCH AD · +2";if(Number(st.rewardedToday||0)>=2){$("watchAd").disabled=true;$("watchAd").textContent="DAILY LIMIT REACHED"}}catch{}}}catch(e){$("leaderboard").innerHTML='<div class="status">Leaderboard unavailable: '+escapeHtml(e.message)+'</div>'}}
async function watchAd(){if(!memberToken||!user||!initData){msg("adStatus","Join from Telegram first.");return}const b=$("watchAd");b.disabled=true;msg("adStatus","Preparing your reward…");try{const prep=await api("/api/adsgram/reward",{method:"POST",headers:headers(),body:JSON.stringify({memberToken,telegramId:String(user.id)})});if(typeof window.show_11992205!=="function")throw new Error("Monetag rewarded SDK is not ready. Reload the Mini App and try again.");msg("adStatus","Ad opened · watch it to completion…");await window.show_11992205();msg("adStatus","Ad completed · confirming points…");const claim=await api("/api/adsgram/reward?userid="+encodeURIComponent(String(user.id)));if(!claim.awarded)throw new Error(claim.cooldown?"Please wait "+claim.cooldown+" seconds before the next reward.":"The reward could not be confirmed. Please contact support if this repeats.");msg("adStatus","✓ Ad completed. +"+Number(claim.points||prep.points||3)+" points credited.",true);await refresh()}catch(e){msg("adStatus",e.message||"Ad was not completed, so no points were added.")}finally{b.disabled=false;await refresh()}}
async function task(taskName){if(!memberToken){msg("taskStatus","Join the Reward Wall first.");return}msg("taskStatus","Verifying task…");document.querySelectorAll(".task").forEach(b=>b.disabled=true);try{const d=await api("/api/rewards/task",{method:"POST",headers:headers(),body:JSON.stringify({memberToken,task:taskName,telegramInitData:initData})});msg("taskStatus",d.awarded?"✓ Task completed · +"+Number(d.points||0)+" points.":(d.message||"Task already completed."),true);await refresh()}catch(e){msg("taskStatus",e.message)}finally{document.querySelectorAll(".task").forEach(b=>b.disabled=false)}}
$("join").addEventListener("click",join);$("watchAd").addEventListener("click",watchAd);document.querySelectorAll(".task").forEach(b=>b.addEventListener("click",()=>task(b.dataset.task)));
identityReady();refresh();if(memberToken&&user){msg("memberStatus","Saved membership found for "+(user.username?"@"+user.username:"your Telegram account")+".",true);$("watchAd").disabled=false}
</script>
</body></html>