<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#100b18">
<title>RUGCIRCUS · Free Raid</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<script src="//libtl.com/sdk.js" data-zone="11992205" data-sdk="show_11992205"></script>
<style>
:root{color-scheme:dark;--bg:#100b18;--panel:#1a1225;--line:#382642;--text:#fff7ff;--muted:#b8a8c5;--pink:#ff438d;--gold:#ffc857;--green:#63e6be}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 20% 0%,#352044 0,transparent 42%),var(--bg);color:var(--text);font:16px/1.5 Inter,system-ui,-apple-system,Segoe UI,sans-serif;min-height:100vh}.wrap{width:min(650px,100%);margin:auto;padding:20px 16px 42px}.top{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:4px 0 20px}.brand{font-weight:950;letter-spacing:.08em}.brand small{display:block;color:var(--muted);font-size:10px;letter-spacing:.2em}.back{color:var(--text);text-decoration:none;border:1px solid var(--line);padding:9px 12px;border-radius:12px}.hero,.panel{border:1px solid var(--line);background:linear-gradient(145deg,rgba(42,27,55,.97),rgba(22,15,31,.97));border-radius:20px;padding:22px;margin-bottom:14px;box-shadow:0 18px 45px #0002}.eyebrow{font-size:11px;font-weight:900;letter-spacing:.17em;color:var(--gold)}h1{font-size:clamp(29px,7vw,43px);line-height:1.04;margin:9px 0 10px;letter-spacing:-.04em}h1 span{color:var(--pink)}p{color:var(--muted);margin:8px 0 14px}.btn{display:flex;align-items:center;justify-content:center;width:100%;min-height:52px;border:0;border-radius:13px;padding:13px 16px;font-weight:950;color:#180d1e;background:linear-gradient(100deg,var(--gold),#ff8c6b);cursor:pointer;text-decoration:none}.btn.pink{background:linear-gradient(100deg,var(--pink),#a477ff);color:white}.btn.ghost{background:#21162c;color:var(--text);border:1px solid var(--line)}.btn:disabled{opacity:.5;cursor:wait}.status{font-size:13px;color:var(--muted);margin-top:12px;overflow-wrap:anywhere}.good{color:var(--green)}.fine{font-size:11px;color:#8e7b9d;margin-top:12px}.steps{display:grid;gap:10px;margin-top:16px}.step{padding:13px;border-radius:13px;background:#0e0915;border:1px solid #30213a}.step b{display:block}.step span{font-size:13px;color:var(--muted)}@media(max-width:420px){.wrap{padding:13px 11px 30px}.hero,.panel{padding:17px;border-radius:17px}}
</style>
</head>
<body><main class="wrap">
<header class="top"><div class="brand">🎪 RUGCIRCUS<small>FREE RAID REWARD</small></div><a class="back" href="/">← Command Center</a></header>
<section class="hero"><div class="eyebrow">MONETAG · REWARDED INTERSTITIAL</div><h1>WATCH AN AD.<br><span>GET 1 FREE RAID.</span></h1><p>Watch the rewarded ad to completion. When Monetag confirms it has finished, one free-raid credit is added to your Telegram account. Return to Command Center and launch your raid.</p><button id="watch" class="btn pink" disabled>CONNECTING TO TELEGRAM…</button><div id="status" class="status">Checking your Telegram account…</div><div class="fine">A new rewarded ad can be claimed once every 3 minutes. Direct-link ads and website push banners are separate and do not grant raid credits.</div></section>
<section class="panel"><h2>How it works</h2><div class="steps"><div class="step"><b>1. Watch the full ad</b><span>Tap WATCH ADS and finish the Monetag rewarded interstitial.</span></div><div class="step"><b>2. Receive one raid credit</b><span>The credit is added only after the ad flow returns successfully and the server accepts the claim.</span></div><div class="step"><b>3. Launch your free raid</b><span>Return to Command Center and submit your raid. The credit is consumed when the raid is published successfully.</span></div></div><a class="btn ghost" href="/" style="margin-top:14px">RETURN TO COMMAND CENTER</a></section>
</main>
<script>
const tg=window.Telegram?.WebApp;try{tg?.ready();tg?.expand()}catch{}
const initData=String(tg?.initData||"");const user=tg?.initDataUnsafe?.user||null;
const button=document.getElementById("watch"),status=document.getElementById("status");
function msg(text,good=false){status.textContent=text;status.classList.toggle("good",good)}
function headers(){return {"content-type":"application/json","x-telegram-init-data":initData}}
async function api(url,opts={}){const r=await fetch(url,{cache:"no-store",...opts});const d=await r.json().catch(()=>({}));if(!r.ok||d.ok===false)throw new Error(d.error||("Request failed ("+r.status+")"));return d}
if(!initData||!user){msg("Open this page from the RUGCIRCUS Telegram Mini App to verify your account.");button.textContent="OPEN INSIDE TELEGRAM";button.disabled=true}
else{msg("Connected as "+(user.username?"@"+user.username:user.first_name||user.id)+". Ready to watch an ad.",true);button.textContent="WATCH ADS · GET 1 FREE RAID";button.disabled=false}
button.addEventListener("click",async()=>{if(!initData||!user)return;button.disabled=true;msg("Checking reward cooldown…");try{await api("/api/adsgram/reward",{method:"POST",headers:headers(),body:JSON.stringify({action:"prepare",telegramInitData:initData})});if(typeof window.show_11992205!=="function")throw new Error("Monetag rewarded SDK is not ready. Reload the Mini App and try again.");msg("Ad opened. Watch it to completion…");await window.show_11992205();msg("Ad finished. Confirming your free-raid credit…");const result=await api("/api/adsgram/reward",{method:"POST",headers:headers(),body:JSON.stringify({action:"claim",telegramInitData:initData})});if(!result.awarded)throw new Error(result.error||"The reward was not confirmed. Please try again.");msg("✓ One free-raid credit added. Return to Command Center to launch your raid.",true);button.textContent="CREDIT ADDED ✓";}catch(e){msg(e.message||"The ad was not completed, so no credit was added.");button.textContent="TRY AGAIN";button.disabled=false}});
</script></body></html>