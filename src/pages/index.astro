function leaderboardToken(){return localStorage.getItem(LEADERBOARD_TOKEN_KEY)||""}
let telegramInitData=localStorage.getItem("rugcircus_telegram_init_data")||"",telegramUser=null,leaderboardIdentity="";
function telegramWebApp(){return window.Telegram?.WebApp||null}
function commandCenterUrl(){return "https://raidrugcircus.pulserapp.com/"}
function returnToCommandCenter(){window.location.assign(commandCenterUrl())}
function updateLeaderboardIdentity(){const box=document.getElementById("leaderIdentity"),join=document.getElementById("joinLeaderboardButton"),manual=document.getElementById("leaderManualForm"),u=document.getElementById("leaderUsername");if(!box)return;const tgName=telegramUser?String(telegramUser.username||("tg_"+telegramUser.id)).replace(/^@/,""):"";if(tgName){leaderboardIdentity=tgName;if(u)u.value="@"+tgName;document.getElementById("connectTelegramButton")?.classList.add("connected");document.querySelector("#connectTelegramButton b")?.replaceChildren(document.createTextNode("TELEGRAM CONNECTED"));document.getElementById("telegramConnectHint").textContent="Verified · Telegram account connected"}else{leaderboardIdentity=String(u?.value||localStorage.getItem("rugcircus_leaderboard_username")||"").trim().replace(/^@/,"");document.getElementById("connectTelegramButton")?.classList.remove("connected");document.querySelector("#connectTelegramButton b")?.replaceChildren(document.createTextNode("LOGIN WITH TELEGRAM"));document.getElementById("telegramConnectHint").textContent="Use your Telegram account to continue"}document.getElementById("connectLeaderboardTonButton")?.classList.toggle("connected",!!walletAddress);document.getElementById("tonConnectHint").textContent=walletAddress?"Wallet linked · ready for rewards":"Connect your Telegram Wallet or another TON wallet";manual.style.display=(!telegramUser&&walletAddress)?"grid":"none";const rows=[];if(telegramUser)rows.push('<div class="status"><b>✈️ Telegram connected</b><span>@'+tgName+"</span></div>");if(walletAddress)rows.push('<div class="status"><b>💎 TON Wallet connected</b><span>'+walletAddress.slice(0,6)+"…"+walletAddress.slice(-5)+"</span></div>");box.innerHTML=rows.length?rows.join(""):'<div class="status">Connect Telegram and TON Wallet to continue.</div>';if(join)join.disabled=!(walletAddress&&leaderboardIdentity)}

function disconnectTelegram(){telegramInitData="";telegramUser=null;leaderboardIdentity="";localStorage.removeItem("rugcircus_telegram_init_data");localStorage.removeItem("rugcircus_leaderboard_username");updateLeaderboardIdentity();updateTelegramLoginButton();toast("Telegram disconnected")}function connectTelegram(){if(telegramUser||telegramInitData){disconnectTelegram();return}const tg=telegramWebApp();if(!tg){toast("Open the Command Center from Telegram to connect Telegram.");return}tg.ready();telegramInitData=tg.initData||"";telegramUser=tg.initDataUnsafe?.user||null;if(!telegramInitData||!telegramUser){toast("Telegram account could not be detected. Open the Mini App from a Telegram button.");return}localStorage.setItem("rugcircus_telegram_init_data",telegramInitData);localStorage.setItem("rugcircus_leaderboard_username",telegramUser.username||("tg_"+telegramUser.id));updateLeaderboardIdentity();updateTelegramLoginButton();toast("Telegram connected")}
function loadLeaderboardMemberStatus(){const el=document.getElementById("leaderMemberStatus"),button=document.getElementById("joinLeaderboardButton");if(!el)return;if(leaderboardToken()){el.innerHTML="<span>✓ YOU ARE ON THE LEADERBOARD</span> · Raid views are being counted.";if(button){button.textContent="✓ LEADERBOARD JOINED";button.disabled=true}}else{el.textContent=walletAddress&&leaderboardIdentity?"Ready to join — press JOIN LEADERBOARD.":"Connect Telegram and TON Wallet to join the leaderboard.";if(button){button.textContent="JOIN LEADERBOARD";button.disabled=false}}}
async function disconnectLeaderboardTon(){await disconnectTon()}async function connectLeaderboardTon(){const a=await connectTon();if(a){updateLeaderboardIdentity();toast("TON Wallet connected for leaderboard")}}

async function joinLeaderboard(){const status=document.getElementById("leaderMemberStatus"),button=document.getElementById("joinLeaderboardButton"),username=String(leaderboardIdentity||document.getElementById("leaderUsername")?.value||"").trim().replace(/^@/,""),wallet=String(walletAddress||localStorage.getItem("rugcircus_ton_wallet")||"").trim();if(!username){status.textContent="Connect Telegram or enter a leaderboard username.";toast("Connect Telegram or enter a leaderboard username");return}if(!wallet){status.textContent="Connect TON Wallet first. Your wallet address is required for rewards.";toast("Connect TON Wallet first");return}if(button)button.disabled=true;status.textContent="Joining leaderboard…";try{const r=await fetch("/api/leaderboard/join",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({username,wallet,memberToken:leaderboardToken(),telegramInitData:telegramInitData||telegramWebApp()?.initData||""})});const raw=await r.text();let d;try{d=JSON.parse(raw)}catch{throw new Error("Leaderboard server returned an invalid response ("+r.status+")")}if(!r.ok||!d.ok)throw new Error(d.error||"Could not join leaderboard");localStorage.setItem(LEADERBOARD_TOKEN_KEY,d.memberToken);localStorage.setItem("rugcircus_leaderboard_username",d.member.username);localStorage.setItem("rugcircus_leaderboard_wallet",d.member.wallet);leaderboardIdentity=d.member.username;updateLeaderboardIdentity();status.textContent="✓ JOINED · @"+String(d.member.username).replace(/^@/,"")+" · "+Number(d.member.points||0)+" points";toast("Leaderboard joined successfully");loadRewards();loadCampaigns()}catch(e){status.textContent="⚠ "+(e?.message||"Could not join leaderboard");toast(status.textContent);if(button)button.disabled=false}}

async function recordLeaderboardView(campaignId){const token=leaderboardToken();if(!token||!campaignId)return;try{await fetch("/api/leaderboard/view",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({memberToken:token,campaignId})})}catch{}}
function watchLeaderboardViews(){const cards=document.querySelectorAll(".token[data-campaign-id],.raid[data-campaign-id]");if(!cards.length)return;const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){recordLeaderboardView(Number(entry.target.dataset.campaignId));observer.unobserve(entry.target)}})},{threshold:.35});cards.forEach(card=>observer.observe(card))}
function restoreLeaderboardForm(){const u=document.getElementById("leaderUsername"),name=localStorage.getItem("rugcircus_leaderboard_username");if(u&&name)u.value="@"+name.replace(/^@/,"");const tg=telegramWebApp();if(tg?.initDataUnsafe?.user&&tg.initData){telegramInitData=tg.initData;telegramUser=tg.initDataUnsafe.user;localStorage.setItem("rugcircus_telegram_init_data",telegramInitData)}updateLeaderboardIdentity();updateTelegramLoginButton();loadLeaderboardMemberStatus()}
async function loadCampaigns(){
 const el=document.getElementById("campaignList"),featured=document.getElementById("featuredRaid"),featuredTag=document.getElementById("featuredRaidTag");
 const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));
 const safeUrl=v=>{try{const u=new URL(String(v||""));return /^https?:$/.test(u.protocol)?u.href:""}catch{return ""}};
 const cardImage=x=>safeUrl(x.logo_url||"");
 const shortCa=v=>{const s=String(v||"");return s.length>16?s.slice(0,8)+"…"+s.slice(-6):s};
