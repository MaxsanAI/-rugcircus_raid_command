}
const externalScriptPromises={};
function updateTelegramLoginButton(){const button=document.getElementById("walletHint");if(!button)return;const name=telegramUser?String(telegramUser.username||("tg_"+telegramUser.id)).replace(/^@/,""):"";if(name){button.textContent="✓ @"+name;button.classList.add("authenticated")}else{button.textContent="✈️ LOGIN WITH TELEGRAM";button.classList.remove("authenticated")}}
function loadExternalScript(src,key){
  const id=key||src;
  if(externalScriptPromises[id])return externalScriptPromises[id];
  if((key==="tonconnect"&&window.TON_CONNECT_UI)||(key==="adsgram"&&window.Adsgram))return Promise.resolve();
  externalScriptPromises[id]=new Promise((resolve,reject)=>{
    const existing=document.querySelector('script[data-rugcircus-loader="'+id+'"]');
    if(existing){
      existing.addEventListener("load",()=>resolve(),{once:true});
      existing.addEventListener("error",()=>reject(new Error("Failed to load "+id)),{once:true});
      return;
    }
    const script=document.createElement("script");
    script.src=src;
    script.async=true;
    script.defer=true;
    script.dataset.rugcircusLoader=id;
    script.onload=()=>resolve();
    script.onerror=()=>{delete externalScriptPromises[id];reject(new Error("Failed to load "+id))};
    document.head.appendChild(script);
  });
  return externalScriptPromises[id];
}
async function ensureAdsgram(){
  if(window.Adsgram)return true;
  try{
    await loadExternalScript("https://sad.adsgram.ai/js/sad.min.js","adsgram");
    return !!window.Adsgram;
  }catch(e){
    console.error("RUGCIRCUS AdsGram SDK load failed",e);
    return false;
  }
}
async function initAdsgram(){
  const button=document.getElementById("watchAdsgramButton"),status=document.getElementById("adsgramStatus");
  if(!button)return;
  if(!adsgramBlockId){button.disabled=true;status.textContent="AdsGram block is not configured yet.";return}
  if(!(await ensureAdsgram())){button.disabled=true;status.textContent="AdsGram could not be loaded.";return}
  try{
    adsgramController=window.Adsgram.init({blockId:adsgramBlockId});
    button.disabled=false;status.textContent="Ready · full rewarded ad required";
    if(!button.dataset.bound){button.dataset.bound="1";button.addEventListener("click",watchAdsgram)}
  }catch{button.disabled=true;status.textContent="AdsGram could not be initialized."}
}
async function watchAdsgram(){
  const button=document.getElementById("watchAdsgramButton"),status=document.getElementById("adsgramStatus");
  const token=leaderboardToken(),tg=telegramWebApp(),telegramId=String(tg?.initDataUnsafe?.user?.id||"");
  if(!token||!telegramId){toast("Join the Reward Wall from Telegram first.");return}
  if(!adsgramController){await initAdsgram();if(!adsgramController){toast("AdsGram is not ready yet.");return}}
  button.disabled=true;status.textContent="Watch the full ad to earn +3 points…";
  try{
    const prep=await fetch("/api/adsgram/reward",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({memberToken:token,telegramId})});
    const pd=await prep.json().catch(()=>({}));
    if(!prep.ok||!pd.ok){
      if(pd.remainingSeconds){status.textContent="Next ad reward in "+Math.ceil(pd.remainingSeconds/60)+" min.";toast(status.textContent)}
      else{status.textContent=pd.error||"Ad reward is not available yet.";toast(status.textContent)}
      button.disabled=false;return
    }
    await adsgramController.show();
    status.textContent="Ad completed · waiting for confirmation…";
    toast("Ad completed. +3 points will be added after confirmation.");
    setTimeout(loadRewards,1800);
  }catch{
    status.textContent="No reward · watch the full ad to earn points.";
    toast("No reward — the ad was not completed.");
    button.disabled=false;
  }
}
