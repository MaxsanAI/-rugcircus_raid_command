const demoTokens=[["RUGCX","RUGCIRCUS","Official ecosystem","82%"],["MEME","MEME MACHINE","Community token","67%"],["CLOWN","CLOWNDAO","Social token","54%"]];
let walletAddress="",treasury="",pay={name:"FEATURED",amount:0.02};
function showPage(p){if(!pages.includes(p))p="home";pages.forEach(x=>document.getElementById("page-"+x).classList.toggle("active",x===p));document.querySelectorAll(".nav button").forEach(b=>b.classList.toggle("active",b.dataset.page===p));window.scrollTo({top:0,behavior:"smooth"})}
document.querySelectorAll("[data-page]").forEach(b=>b.addEventListener("click",()=>showPage(b.dataset.page)));
document.querySelectorAll("[data-page-link]").forEach(b=>b.addEventListener("click",()=>showPage(b.dataset.pageLink)));
function toast(msg){const t=document.getElementById("toast");t.textContent=msg;t.classList.add("show");clearTimeout(window.__toast);window.__toast=setTimeout(()=>t.classList.remove("show"),2800)}
async function config(){try{const r=await fetch("/api/config");const d=await r.json();treasury=d.treasury||"";if(d.monetagSmartLink){const a=document.getElementById("sponsorLink");a.href=d.monetagSmartLink;a.onclick=null}document.getElementById("premiumStatus").textContent=treasury?"Free campaigns pay to the RUGCIRCUS treasury. Premium Operators can use their own payout wallet.":"Treasury is not configured yet."}catch{}}
async function connect(){if(!window.solana||!window.solana.isPhantom){toast("Install Phantom or another Solana wallet");return null}try{const r=await window.solana.connect();walletAddress=r.publicKey.toString();document.getElementById("wallet").textContent=walletAddress.slice(0,4)+"…"+walletAddress.slice(-4);return walletAddress}catch{toast("Wallet connection cancelled");return null}}
function openPay(name,amount){pay={name,amount};document.getElementById("payTitle").textContent=name;document.getElementById("payAmount").textContent=amount.toFixed(2)+" SOL";document.getElementById("payStatus").textContent="Connect wallet, then confirm the transaction.";document.getElementById("payModal").classList.add("open")}
function closePay(){document.getElementById("payModal").classList.remove("open")}
function openPremium(){document.getElementById("premiumModal").classList.add("open")}
function closePremium(){document.getElementById("premiumModal").classList.remove("open")}
async function transfer(lamports,to){const address=await connect();if(!address)return null;const connection=new solanaWeb3.Connection("https://api.mainnet-beta.solana.com","confirmed");const tx=new solanaWeb3.Transaction().add(solanaWeb3.SystemProgram.transfer({fromPubkey:new solanaWeb3.PublicKey(address),toPubkey:new solanaWeb3.PublicKey(to),lamports}));const sent=await window.solana.signAndSendTransaction(tx);await connection.confirmTransaction(sent.signature,"confirmed");return sent.signature}
async function payCampaign(){try{document.getElementById("payStatus").textContent=pay.amount===0?"Connecting wallet…":"Sending and verifying…";const address=await connect();if(!address)return;const body={package:pay.name,mintAddress:document.getElementById("ca").value.trim(),ticker:document.getElementById("ticker").value.trim(),name:document.getElementById("tokenName").value.trim(),xUrl:document.getElementById("xUrl").value.trim(),tiktokUrl:document.getElementById("ttUrl").value.trim(),telegramUrl:document.getElementById("tgUrl").value.trim(),raidCopy:document.getElementById("raidCopy").value.trim(),payoutWallet:(document.getElementById("payoutWallet").value||treasury).trim(),payerWallet:address};let endpoint="/api/campaign/create";if(pay.amount===0)endpoint="/api/campaign/free";else{const sig=await transfer(Math.round(pay.amount*1e9),body.payoutWallet);if(!sig)return;body.signature=sig}const r=await fetch(endpoint,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(body)});const d=await r.json();if(!d.ok)throw new Error(d.error||"Raid launch failed");closePay();toast(pay.amount===0?"Free raid launched — "+d.remainingFreeRaids+" free raid(s) left":"Raid activated until "+new Date(d.endsAt).toLocaleString());loadCampaigns()}catch(e){document.getElementById("payStatus").textContent=e.message||"Raid launch failed";toast(e.message||"Raid launch failed")}}
async function payPremium(){if(!treasury){toast("Treasury wallet is not configured");return}try{const sig=await transfer(150000000,treasury);if(!sig)return;const r=await fetch("/api/premium/activate",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({walletAddress:walletAddress,signature:sig})});const d=await r.json();if(!d.ok)throw new Error(d.error||"Premium activation failed");closePremium();document.getElementById("premiumResult").textContent="Premium active until "+new Date(d.expiresAt).toLocaleString();toast("Premium Operator activated")}catch(e){toast(e.message||"Premium activation failed")}}
document.getElementById("tokenList").innerHTML=demoTokens.map(t=>'<div class="token"><div class="coin">'+t[0][0]+'</div><div><b>$'+t[0]+' · '+t[1]+'</b><small>'+t[2]+' · social activity</small></div><span class="score">'+t[3]+'</span></div>').join("");
document.getElementById("wallet").addEventListener("click",connect);
config();loadCampaigns();
</script>
