async function joinLeaderboard(){const status=document.getElementById("leaderMemberStatus"),button=document.getElementById("joinLeaderboardButton");let username=String(leaderboardIdentity||document.getElementById("leaderUsername")?.value||"").trim().replace(/^@/,"");let wallet=String(walletAddress||localStorage.getItem("rugcircus_wallet")||"").trim();const provider=walletProvider||detectPhantom();if(!wallet&&provider?.publicKey){try{wallet=provider.publicKey.toString();walletAddress=wallet;localStorage.setItem("rugcircus_wallet",wallet)}catch{}}if(!username){status.textContent="Connect Telegram or enter a leaderboard username.";toast("Connect Telegram or enter a leaderboard username");return}if(!wallet){status.textContent="Connect Phantom first. Your wallet address is required for rewards.";toast("Connect Phantom first");return}if(button)button.disabled=true;status.textContent="Joining leaderboard…";try{const r=await fetch("/api/leaderboard/join",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({username,wallet,memberToken:leaderboardToken(),telegramInitData})});const raw=await r.text();let d;try{d=JSON.parse(raw)}catch{throw new Error("Leaderboard server returned an invalid response ("+r.status+")")}if(!r.ok||!d.ok)throw new Error(d.error||"Could not join leaderboard");localStorage.setItem(LEADERBOARD_TOKEN_KEY,d.memberToken);localStorage.setItem("rugcircus_leaderboard_username",d.member.username);localStorage.setItem("rugcircus_leaderboard_wallet",d.member.wallet);leaderboardIdentity=d.member.username;updateLeaderboardIdentity();status.textContent="✓ JOINED · @"+String(d.member.username).replace(/^@/,"")+" · "+Number(d.member.points||0)+" points";toast("Leaderboard joined successfully");loadRewards();loadCampaigns()}catch(e){status.textContent="⚠ "+(e?.message||"Could not join leaderboard");toast(status.textContent);if(button)button.disabled=false}}
