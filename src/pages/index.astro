<script>
const PUMP="https://pump.fun/coin/3wLrSM5gkSSSQGoivnnN32Xh6ffjDwFeJFMqnNnSpump";
const FREE_USER_KEY="rugcircus_free_user_id";
function freeUserId(){let id=localStorage.getItem(FREE_USER_KEY);if(!id){id=Date.now().toString(36)+"_"+Math.random().toString(36).slice(2);localStorage.setItem(FREE_USER_KEY,id)}return id}
const TG="https://t.me/rugcxx";
const X="https://x.com/RugCircusX";
const pages=["home","explore","create","premium","admin","movers","analytics","leaderboard"];
let walletAddress=localStorage.getItem("rugcircus_wallet")||"",walletProvider=null,treasury="",pay={name:"FEATURED",amount:0.02};
function showPage(p){if(!pages.includes(p))p="home";pages.forEach(x=>document.getElementById("page-"+x).classList.toggle("active",x===p));document.querySelectorAll(".nav button").forEach(b=>b.classList.toggle("active",b.dataset.page===p));if(p==="analytics")loadAnalytics();window.scrollTo({top:0,behavior:"smooth"})}
document.querySelectorAll("[data-page]").forEach(b=>b.addEventListener("click",()=>showPage(b.dataset.page)));
document.querySelectorAll("[data-page-link]").forEach(b=>b.addEventListener("click",()=>showPage(b.dataset.pageLink)));
function toast(msg){const t=document.getElementById("toast");t.textContent=msg;t.classList.add("show");clearTimeout(window.__toast);window.__toast=setTimeout(()=>t.classList.remove("show"),2800)}
async function loadCampaigns(){
 const el=document.getElementById("campaignList"),featured=document.getElementById("featuredRaid"),featuredTag=document.getElementById("featuredRaidTag");
 const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));
 const safeUrl=v=>{try{const u=new URL(String(v||""));return /^https?:$/.test(u.protocol)?u.href:""}catch{return ""}};
 const cardImage=x=>safeUrl(x.logo_url||"");
 const buttonsFor=x=>[x.x_url?'<a class="campaignButton hot" href="/api/raid/click?campaign='+x.id+'&platform=x&wallet='+encodeURIComponent(walletAddress)+'" target="_blank" rel="noopener">𝕏 X RAID</a>':"",x.tiktok_url?'<a class="campaignButton tiktok" href="/api/raid/click?campaign='+x.id+'&platform=tiktok&wallet='+encodeURIComponent(walletAddress)+'" target="_blank" rel="noopener">🎵 TIKTOK RAID</a>':"",x.telegram_url?'<a class="campaignButton telegram" href="/api/raid/click?campaign='+x.id+'&platform=telegram&wallet='+encodeURIComponent(walletAddress)+'" target="_blank" rel="noopener">✈️ TELEGRAM RAID</a>':"",x.pump_callout_url?'<a class="campaignButton callout" href="/api/raid/click?campaign='+x.id+'&platform=callout&wallet='+encodeURIComponent(walletAddress)+'" target="_blank" rel="noopener">🎯 PUMP CALLOUT</a>':"",x.mint_address?'<a class="campaignButton gold" href="'+safeUrl(x.pump_url||("https://pump.fun/coin/"+x.mint_address))+'" target="_blank" rel="noopener">🪙 OPEN PUMP.FUN</a>':""].filter(Boolean).join("");
 const imageHtml=x=>{const u=cardImage(x);return u?'<div class="raidImage"><img src="'+esc(u)+'" alt="$'+esc(x.ticker||"TOKEN")+' raid image" loading="lazy" referrerpolicy="no-referrer"><div class="raidImageFallback">⚔️</div></div>':""};
 try{
  const r=await fetch("/api/campaigns",{cache:"no-store"}),d=await r.json();if(!d.ok)throw new Error(d.error||"Campaigns unavailable");
  if(!d.campaigns?.length){el.innerHTML='<div class="status">No active campaigns right now.</div>';featured.innerHTML='<div class="status">No active raid right now.</div>';featuredTag.textContent="IDLE";return}
  const uniqueCampaigns=[];const seenCampaigns=new Set();for(const x of d.campaigns||[]){const key=x.mint_address||x.id;if(seenCampaigns.has(key))continue;seenCampaigns.add(key);uniqueCampaigns.push(x)}el.innerHTML=uniqueCampaigns.map(x=>'<div class="token"><div class="coin">'+esc((x.ticker||"R")[0])+'</div><div class="tokenMain"><b>$'+esc(x.ticker||"TOKEN")+' · '+esc(x.name||"Token")+'</b><small>'+esc(x.package||"RAID")+' · live campaign</small><small class="caLine">CA: '+esc(x.mint_address||"Not available")+'</small></div><div class="campaignButtons">'+buttonsFor(x)+'</div></div>').join("");
  const f=uniqueCampaigns[0],image=imageHtml(f);
  featured.innerHTML='<div class="raid">'+image+'<div class="raidTitle"><div><div class="live">● ACTIVE RAID</div><h3>$'+esc(f.ticker||"TOKEN")+' — '+esc(f.name||"Campaign")+'</h3><span class="muted">'+esc(f.raid_copy||"Live social campaign")+'</span><div class="caBox"><span>CA</span><code>'+esc(f.mint_address||"Not available")+'</code><button class="copyCa" data-ca="'+esc(f.mint_address||"")+'">COPY CA</button></div></div><b>'+esc(f.package||"RAID")+'</b></div><div class="bar"><i></i></div><div class="campaignButtons">'+buttonsFor(f)+'</div></div>';
  featuredTag.textContent="LIVE";
  featured.querySelectorAll(".copyCa").forEach(b=>b.addEventListener("click",async()=>{if(!b.dataset.ca)return;try{await navigator.clipboard.writeText(b.dataset.ca);toast("Contract address copied")}catch{toast("Could not copy contract address")}}));
  featured.querySelectorAll(".raidImage img").forEach(img=>img.addEventListener("error",()=>{img.parentElement.innerHTML='<div class="raidImageFallback">⚔️ IMAGE UNAVAILABLE</div>'},{once:true}));
 }catch{el.innerHTML='<div class="status">Live campaigns unavailable right now.</div>';featured.innerHTML='<div class="status">Active raid unavailable right now.</div>';featuredTag.textContent="OFFLINE"}
}
async function loadExplore(){try{const r=await fetch("/api/campaigns",{cache:"no-store"});const d=await r.json();const el=document.getElementById("tokenList");if(!d.ok)throw new Error();const seen=new Set();const rows=[];for(const x of d.campaigns||[]){const key=x.mint_address||x.ticker||x.id;if(seen.has(key))continue;seen.add(key);rows.push(x)}if(!rows.length){el.innerHTML='<div class="status">No active tokens yet. Launch a raid to add the first token.</div>';return}el.innerHTML=rows.map(x=>'<div class="token"><div class="coin">'+String((x.ticker||"T")[0])+'</div><div><b>$'+String(x.ticker||"TOKEN")+' · '+String(x.name||"Token")+'</b><small>'+String(x.package||"RAID")+' · active campaign</small></div><a class="tiny" href="'+String(x.pump_url||("https://pump.fun/coin/"+(x.mint_address||"")))+'" target="_blank" rel="noopener">Pump.fun ↗</a></div>').join("")}catch{document.getElementById("tokenList").innerHTML='<div class="status">Token directory unavailable right now.</div>'}}
async function loadAnalytics(){try{const r=await fetch("/api/analytics");const d=await r.json();if(!d.ok)throw new Error(d.error||"Analytics unavailable");document.getElementById("aCampaigns").textContent=d.activeCampaigns;document.getElementById("aRaids").textContent=d.totalActions;document.getElementById("aX").textContent=d.platforms.x||0;document.getElementById("aTikTok").textContent=d.platforms.tiktok||0;document.getElementById("aTelegram").textContent=d.platforms.telegram||0;document.getElementById("aCallouts").textContent=d.platforms.callout||0;document.getElementById("analyticsStatus").textContent="Live activity loaded";}catch(e){document.getElementById("analyticsStatus").textContent="Analytics unavailable right now"}}
async function loadRewards(){try{const r=await fetch("/api/rewards");const d=await r.json();if(!d.ok)throw new Error();document.getElementById("rewardPoolStatus").textContent="Reward pool: "+Number(d.rewardPoolSol).toFixed(3)+" SOL";document.getElementById("rewardBase").textContent=Number(d.basePoolSol).toFixed(3);document.getElementById("rewardRevenue").textContent=Number(d.revenueContributionSol).toFixed(3);document.getElementById("rewardPoolUpdated").textContent="Current week paid revenue: "+Number(d.paidRevenueSol).toFixed(3)+" SOL";const list=document.getElementById("leaderboardList");if(!d.leaderboard?.length){list.innerHTML='<div class="status">No raid points yet. Connect a wallet before joining raids.</div>';return;}list.innerHTML=d.leaderboard.map((x,i)=>'<div class="row"><span class="rank">'+(i<3?["🥇","🥈","🥉"][i]:i+1)+'</span><b>'+String(x.wallet||"Anonymous")+'</b><strong>'+Number(x.points||0)+' pts</strong></div>').join("");}catch{document.getElementById("rewardPoolUpdated").textContent="Reward pool unavailable right now"}}
async function config(){try{const r=await fetch("/api/config");const d=await r.json();treasury=d.treasury||"";if(d.monetagSmartLink){const a=document.getElementById("sponsorLink");a.href=d.monetagSmartLink;a.onclick=null}document.getElementById("premiumStatus").textContent=treasury?"Free campaigns pay to the RUGCIRCUS treasury. Premium Operators can use their own payout wallet.":"Treasury is not configured yet."}catch{}}
function isMobile(){return /Android|iPhone|iPad|iPod/i.test(navigator.userAgent)}
function phantomBrowseUrl(){return "https://phantom.app/ul/browse/"+encodeURIComponent(window.location.href)}
function openPhantom(){window.location.href=phantomBrowseUrl()}
function detectPhantom(){return window.phantom?.solana||window.solana||null}
async function connect(){
  const provider=detectPhantom();
  if(!provider){
    if(isMobile()){
      openPhantom();
      return null;
    }
    toast("Install the Phantom desktop extension to connect your wallet");
    return null;
  }
  walletProvider=provider;
  try{
    const r=await provider.connect();
    walletAddress=(r.publicKey||provider.publicKey).toString();
    const hint=document.getElementById("walletHint");
    if(hint)hint.textContent="PHANTOM CONNECTED · "+walletAddress.slice(0,4)+"…"+walletAddress.slice(-4);
    localStorage.setItem("rugcircus_wallet",walletAddress);
    return walletAddress;
  }catch{
    toast("Phantom connection cancelled");
    return null;
  }
}
function openPay(name,amount){pay={name,amount};document.getElementById("payTitle").textContent=name;document.getElementById("payAmount").textContent=amount.toFixed(2)+" SOL";document.getElementById("payStatus").textContent=Number(amount)===0?"No wallet required. The raid will be posted automatically to @rugcxx.":"A wallet is required only for this paid package.";document.getElementById("payModal").classList.add("open")}
function closePay(){document.getElementById("payModal").classList.remove("open")}
function openPremium(){document.getElementById("premiumModal").classList.add("open")}
function closePremium(){document.getElementById("premiumModal").classList.remove("open")}
async function transfer(lamports,to,address=null){
  const from=address||await connect();
  if(!from)return null;
  const provider=walletProvider||detectPhantom();
  if(!provider){toast("Phantom wallet is not available");return null}
  const connection=new solanaWeb3.Connection("https://api.mainnet-beta.solana.com","confirmed");
  const tx=new solanaWeb3.Transaction().add(solanaWeb3.SystemProgram.transfer({
    fromPubkey:new solanaWeb3.PublicKey(from),
    toPubkey:new solanaWeb3.PublicKey(to),
    lamports
  }));
  const sent=await provider.signAndSendTransaction(tx);
  await connection.confirmTransaction(sent.signature,"confirmed");
  return sent.signature
}
async function payCampaign(){const status=document.getElementById("payStatus");try{const mintAddress=document.getElementById("ca").value.trim();const telegramGroup=document.getElementById("tgGroup").value.trim();if(!mintAddress){status.textContent="Enter the Contract Address.";toast("Contract Address is required");return}if(!telegramGroup){status.textContent="Enter the Telegram Raid Group.";toast("Telegram Raid Group is required");return}const isFree=Number(pay.amount)===0;status.textContent=isFree?"Launching free raid…":"Connecting wallet…";const body={package:pay.name,mintAddress,ticker:document.getElementById("ticker").value.trim(),name:document.getElementById("tokenName").value.trim(),xUrl:document.getElementById("xUrl").value.trim(),imageUrl:document.getElementById("imageUrl").value.trim(),tiktokUrl:document.getElementById("ttUrl").value.trim(),telegramUrl:document.getElementById("tgUrl").value.trim(),telegramGroup,pumpCalloutUrl:document.getElementById("calloutUrl").value.trim(),raidCopy:document.getElementById("raidCopy").value.trim(),clientId:freeUserId()};let endpoint="/api/campaign/free";if(!isFree){endpoint="/api/campaign/create";const address=await connect();if(!address)return;body.payoutWallet=treasury.trim();body.payerWallet=address;if(!body.payoutWallet){status.textContent="Treasury wallet is not configured.";toast("Treasury wallet is not configured");return}const sig=await transfer(Math.round(pay.amount*1e9),body.payoutWallet,address);if(!sig)return;body.signature=sig}const r=await fetch(endpoint,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(body)});const raw=await r.text();let d;try{d=JSON.parse(raw)}catch{throw new Error("Launch server returned an invalid response ("+r.status+")")}if(!r.ok||!d.ok)throw new Error(d.error||"Raid launch failed ("+r.status+")");closePay();toast(isFree?"Free raid launched — posted to @rugcxx":"Raid activated until "+new Date(d.endsAt).toLocaleString());loadCampaigns()}catch(e){const msg=e?.message||"Raid launch failed";status.textContent=msg;toast(msg)}}
async function payPremium(){if(!treasury){toast("Treasury wallet is not configured");return}try{const sig=await transfer(150000000,treasury);if(!sig)return;const r=await fetch("/api/premium/activate",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({walletAddress:walletAddress,signature:sig})});const d=await r.json();if(!d.ok)throw new Error(d.error||"Premium activation failed");closePremium();document.getElementById("premiumResult").textContent="Premium active until "+new Date(d.expiresAt).toLocaleString();toast("Premium Operator activated")}catch(e){toast(e.message||"Premium activation failed")}}



// Explicit button bindings: do not rely on inline onclick handlers.
document.getElementById("launchFreeRaid")?.addEventListener("click",()=>openPay("FREE RAID",0));
document.getElementById("launchFeatured")?.addEventListener("click",()=>openPay("FEATURED",0.02));
document.getElementById("launchMega")?.addEventListener("click",()=>openPay("MEGA RAID",0.05));
document.getElementById("launchFrontRow")?.addEventListener("click",()=>openPay("FRONT ROW",0.10));
document.getElementById("openPremiumButton")?.addEventListener("click",openPremium);
document.getElementById("closePayButton")?.addEventListener("click",closePay);
document.getElementById("payCampaignButton")?.addEventListener("click",payCampaign);
document.getElementById("closePremiumButton")?.addEventListener("click",closePremium);
document.getElementById("payPremiumButton")?.addEventListener("click",payPremium);
window.addEventListener("error",e=>{console.error(e.error||e.message);toast("Page error: "+(e.message||"JavaScript error"));});
window.addEventListener("unhandledrejection",e=>{console.error(e.reason);toast("Request error: "+(e.reason?.message||"Unexpected error"));});
if(detectPhantom()){walletProvider=detectPhantom();const hint=document.getElementById("walletHint");if(hint&&walletAddress)hint.textContent="PHANTOM READY · "+walletAddress.slice(0,4)+"…"+walletAddress.slice(-4)}config();loadCampaigns();loadAnalytics();loadRewards();
</script>
