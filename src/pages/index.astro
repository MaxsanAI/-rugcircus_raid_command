let editingCampaignId=null;
function managerHeaders(){
  return {"x-wallet-address":String(walletAddress||localStorage.getItem("rugcircus_wallet")||""),"x-free-user-id":freeUserId()};
}
function escManager(v){
  return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));
}
function renderMyCampaigns(rows){
  const el=document.getElementById("manageList");if(!el)return;
  if(!rows.length){el.innerHTML="<div class=\"manageEmpty\">No campaigns found for this browser or wallet yet.</div>";return}
  el.innerHTML=rows.map(x=>"<div class=\"manageCard\" data-manage-id=\""+Number(x.id)+"\"><div class=\"manageTop\"><div><b>$"+escManager(x.ticker||"TOKEN")+" · "+escManager(x.name||"Campaign")+"</b><div class=\"manageMeta\">"+escManager(x.package||"RAID")+" · "+escManager(String(x.status||"active").toUpperCase())+" · "+(x.amount_sol?Number(x.amount_sol).toFixed(3)+" SOL":"FREE")+"<br>CA: "+escManager(x.mint_address||"")+"</div></div><span class=\"tag\">"+escManager(String(x.status||"active").toUpperCase())+"</span></div><div class=\"manageActions\"><button class=\"edit\" data-edit-campaign=\""+Number(x.id)+"\">✏️ EDIT</button><button class=\"publish\" data-publish-campaign=\""+Number(x.id)+"\">📣 PUBLISH AGAIN</button><button class=\"share\" data-share-campaign=\""+Number(x.id)+"\">📤 SHARE CARD</button><button class=\"delete\" data-delete-campaign=\""+Number(x.id)+"\">🗑 DELETE</button></div></div>").join("");
  el.querySelectorAll("[data-edit-campaign]").forEach(b=>b.addEventListener("click",()=>openCampaignEditor(rows.find(x=>Number(x.id)===Number(b.dataset.editCampaign)))));
  el.querySelectorAll("[data-publish-campaign]").forEach(b=>b.addEventListener("click",()=>publishCampaignAgain(Number(b.dataset.publishCampaign))));
  el.querySelectorAll("[data-share-campaign]").forEach(b=>b.addEventListener("click",()=>shareCampaign(Number(b.dataset.shareCampaign),rows.find(x=>Number(x.id)===Number(b.dataset.shareCampaign)))));
  el.querySelectorAll("[data-delete-campaign]").forEach(b=>b.addEventListener("click",()=>deleteMyCampaign(Number(b.dataset.deleteCampaign))));
}
function openCampaignEditor(x){
  if(!x)return;
  editingCampaignId=Number(x.id);
  document.getElementById("editTicker").value=x.ticker||"";
  document.getElementById("editName").value=x.name||"";
  document.getElementById("editImage").value=x.logo_url||"";
  document.getElementById("editX").value=x.x_url||"";
  document.getElementById("editTikTok").value=x.tiktok_url||"";
  document.getElementById("editTelegram").value=x.telegram_url||"";
  document.getElementById("editCallout").value=x.pump_callout_url||"";
  document.getElementById("editStatus").value=["active","paused","ended"].includes(String(x.status||""))?x.status:"active";
  document.getElementById("editCopy").value=x.raid_copy||"";
  document.getElementById("manageEditor").classList.add("open");
  document.getElementById("manageEditorEmpty").style.display="none";
  document.getElementById("editStatusMessage").textContent="Editing campaign #"+x.id;
  document.getElementById("manageEditor").scrollIntoView({behavior:"smooth",block:"start"});
}
function closeCampaignEditor(){
  editingCampaignId=null;
  document.getElementById("manageEditor")?.classList.remove("open");
  document.getElementById("manageEditorEmpty").style.display="";
}
async function loadMyCampaigns(){
  const status=document.getElementById("manageStatus"),el=document.getElementById("manageList");if(!status||!el)return;
  status.textContent="Loading your campaigns…";
  try{
    const r=await fetch("/api/campaign/manage",{cache:"no-store",headers:managerHeaders()});
    const d=await r.json().catch(()=>({}));
    if(!r.ok||!d.ok)throw new Error(d.error||"Could not load your campaigns");
    renderMyCampaigns(d.campaigns||[]);
    status.textContent=(d.campaigns||[]).length+" campaign"+((d.campaigns||[]).length===1?"":"s")+" found";
    document.getElementById("manageConnectWallet").textContent=walletAddress?"👻 WALLET CONNECTED":"👻 CONNECT WALLET";
  }catch(e){status.textContent=e?.message||"Could not load your campaigns"}
}
async function saveCampaignEdit(){
  const status=document.getElementById("editStatusMessage");
  if(!editingCampaignId){status.textContent="Select a campaign first.";return}
  const body={id:editingCampaignId,ticker:document.getElementById("editTicker").value,name:document.getElementById("editName").value,imageUrl:document.getElementById("editImage").value,xUrl:document.getElementById("editX").value,tiktokUrl:document.getElementById("editTikTok").value,telegramUrl:document.getElementById("editTelegram").value,pumpCalloutUrl:document.getElementById("editCallout").value,status:document.getElementById("editStatus").value,raidCopy:document.getElementById("editCopy").value};
  status.textContent="Saving changes…";
  try{
    const r=await fetch("/api/campaign/manage",{method:"POST",headers:{"content-type":"application/json",...managerHeaders()},body:JSON.stringify(body)});
    const d=await r.json().catch(()=>({}));
    if(!r.ok||!d.ok)throw new Error(d.error||"Could not save changes");
    status.textContent="✓ Campaign updated.";
    toast("Campaign updated");
    closeCampaignEditor();
    await loadMyCampaigns();
    await loadCampaigns();
  }catch(e){status.textContent=e?.message||"Could not save changes";toast(status.textContent)}
}
async function publishCampaignAgain(id){
  const status=document.getElementById("editStatusMessage")||document.getElementById("manageStatus");
  status.textContent="Publishing updated raid card to Telegram…";
  try{
    const r=await fetch("/api/campaign/manage",{method:"POST",headers:{"content-type":"application/json",...managerHeaders()},body:JSON.stringify({id,action:"publishAgain"})});
    const d=await r.json().catch(()=>({}));
    if(!r.ok||!d.ok)throw new Error(d.error||"Could not publish the raid again");
    status.textContent="✓ Updated raid card published to Telegram.";
    toast("Updated raid card published to Telegram");
  }catch(e){status.textContent=e?.message||"Could not publish the raid again";toast(status.textContent)}
}
function shareCampaign(id,campaign){
  const url=new URL("/?raid="+encodeURIComponent(id),window.location.origin).toString();
  const ticker=String(campaign?.ticker||"RUGCX").replace(/^\$/,"");
  const name=String(campaign?.name||"Raid");
  const text="🎪 RUGCIRCUS RAID · $"+ticker+" · "+name+"\nJoin the raid:";
  const tg="https://t.me/share/url?url="+encodeURIComponent(url)+"&text="+encodeURIComponent(text);
  const x="https://x.com/intent/post?text="+encodeURIComponent(text)+"&url="+encodeURIComponent(url);
  if(typeof navigator.share==="function"){navigator.share({title:"RUGCIRCUS RAID · $"+ticker,text,url}).catch(()=>{});return}
  const choice=window.prompt("Share this raid: 1 = X, 2 = Telegram, 3 = Copy link","1");
  if(choice==="1")window.open(x,"_blank","noopener");
  else if(choice==="2")window.open(tg,"_blank","noopener");
  else if(choice==="3")navigator.clipboard?.writeText(url).then(()=>toast("Raid link copied"));
}
async function deleteMyCampaign(id){
  if(!confirm("Delete this campaign? It will be removed from the live campaign list while its history stays in the database."))return;
  const status=document.getElementById("manageStatus");
  status.textContent="Deleting campaign…";
  try{
    const r=await fetch("/api/campaign/manage",{method:"DELETE",headers:{"content-type":"application/json",...managerHeaders()},body:JSON.stringify({id})});
    const d=await r.json().catch(()=>({}));
    if(!r.ok||!d.ok)throw new Error(d.error||"Could not delete campaign");
    toast("Campaign deleted");
    closeCampaignEditor();
    await loadMyCampaigns();
    await loadCampaigns();
  }catch(e){status.textContent=e?.message||"Could not delete campaign";toast(status.textContent)}
}
async function config(){try{const r=await fetch("/api/config",{cache:"no-store",headers:walletAddress?{"x-wallet-address":walletAddress}:{}});const d=await r.json();treasury=d.treasury||"";premiumOperator=Boolean(d.premiumOperator);if(d.monetagSmartLink){const a=document.getElementById("sponsorLink");a.href="/api/sponsor/click";a.onclick=e=>{e.preventDefault();window.open("/api/sponsor/click?memberToken="+encodeURIComponent(leaderboardToken()),"_blank","noopener")}}document.getElementById("premiumStatus").textContent=treasury?"Free campaigns pay to the RUGCIRCUS treasury. Premium Operators can use their own payout wallet.":"Treasury is not configured yet."}catch{}}
function isMobile(){return /Android|iPhone|iPad|iPod/i.test(navigator.userAgent)}
function phantomBrowseUrl(){return "https://phantom.app/ul/browse/"+encodeURIComponent(window.location.href)+"?ref="+encodeURIComponent(window.location.origin)}
function openPhantom(){window.location.href=phantomBrowseUrl()}
function detectPhantom(){return window.phantom?.solana||window.solana||null}
async function connect(){
  const provider=detectPhantom();
  if(!provider){
    if(isMobile()){
      openPhantom();
      return null;
    }
    toast("Install the Phantom desktop extension to connect your wallet");
    return null;
  }
  walletProvider=provider;
  try{
    const r=await provider.connect();
    walletAddress=(r.publicKey||provider.publicKey).toString();
    const hint=document.getElementById("walletHint");
    if(hint)hint.textContent="PHANTOM CONNECTED · "+walletAddress.slice(0,4)+"…"+walletAddress.slice(-4);
    localStorage.setItem("rugcircus_wallet",walletAddress);
    await config();
    return walletAddress;
  }catch{
    toast("Phantom connection cancelled");
    return null;
  }
}
function openPay(name,amount){pay={name,amount};document.getElementById("payTitle").textContent=name;document.getElementById("payAmount").textContent=amount.toFixed(2)+" SOL";document.getElementById("payStatus").textContent=Number(amount)===0?"No wallet required. The raid will be posted automatically to @rugcxx.":"A wallet is required only for this paid package.";document.getElementById("payModal").classList.add("open")}
function closePay(){document.getElementById("payModal").classList.remove("open")}
function openPremium(){document.getElementById("premiumModal").classList.add("open")}
function closePremium(){document.getElementById("premiumModal").classList.remove("open")}
async function transfer(lamports,to,address=null){
  const from=address||await connect();
  if(!from)return null;
  const provider=walletProvider||detectPhantom();
  if(!provider){toast("Phantom wallet is not available");return null}
  if(!to){toast("Payment recipient is not configured");return null}
  if(!Number.isSafeInteger(Number(lamports))||Number(lamports)<=0){toast("Invalid payment amount");return null}
  let recipient;
  try{recipient=new solanaWeb3.PublicKey(to)}catch{toast("Payment recipient is invalid");return null}
  const rpcEndpoints=["https://solana-rpc.publicnode.com","https://api.mainnet-beta.solana.com"];
  try{
    let connection=null, latest=null, lastError=null;
    for(const rpc of rpcEndpoints){
      try{
        const candidate=new solanaWeb3.Connection(rpc,"confirmed");
        latest=await candidate.getLatestBlockhash("confirmed");
        connection=candidate;
        break;
      }catch(e){lastError=e}
    }
    if(!connection||!latest)throw new Error("Solana RPC access failed. Please try again in a moment.");
    const {blockhash,lastValidBlockHeight}=latest;
    const tx=new solanaWeb3.Transaction({
      feePayer:new solanaWeb3.PublicKey(from),
      recentBlockhash:blockhash
    }).add(solanaWeb3.SystemProgram.transfer({
      fromPubkey:new solanaWeb3.PublicKey(from),
      toPubkey:recipient,
      lamports:Number(lamports)
    }));
    const sent=await provider.signAndSendTransaction(tx);
    const signature=sent?.signature||sent;
    if(!signature)throw new Error("Phantom did not return a transaction signature");
    await connection.confirmTransaction({signature,lastValidBlockHeight,blockhash},"confirmed");
    return signature;
  }catch(e){
    console.error("Solana payment failed",e);
    throw new Error(e?.message||"Solana payment failed");
  }
}
async function payCampaign(){const status=document.getElementById("payStatus");try{const mintAddress=document.getElementById("ca").value.trim();const telegramGroup=document.getElementById("tgGroup").value.trim();if(!mintAddress){status.textContent="Enter the Contract Address.";toast("Contract Address is required");return}if(!telegramGroup){status.textContent="Enter the Telegram Raid Group.";toast("Telegram Raid Group is required");return}const isFree=Number(pay.amount)===0;status.textContent=isFree?"Launching free raid…":"Connecting wallet…";const body={package:pay.name,mintAddress,ticker:document.getElementById("ticker").value.trim(),name:document.getElementById("tokenName").value.trim(),xUrl:document.getElementById("xUrl").value.trim(),imageUrl:document.getElementById("imageUrl").value.trim(),tiktokUrl:document.getElementById("ttUrl").value.trim(),telegramUrl:document.getElementById("tgUrl").value.trim(),telegramGroup,pumpCalloutUrl:document.getElementById("calloutUrl").value.trim(),raidCopy:document.getElementById("raidCopy").value.trim(),clientId:freeUserId()};let endpoint="/api/campaign/free";if(!isFree){endpoint="/api/campaign/create";const address=await connect();if(!address)return;body.payoutWallet=treasury.trim();body.payerWallet=address;if(!body.payoutWallet){status.textContent="Treasury wallet is not configured.";toast("Treasury wallet is not configured");return}const sig=await transfer(Math.round(pay.amount*1e9),body.payoutWallet,address);if(!sig)return;body.signature=sig}const r=await fetch(endpoint,{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify(body)});const raw=await r.text();let d;try{d=JSON.parse(raw)}catch{throw new Error("Launch server returned an invalid response ("+r.status+")")}if(!r.ok||!d.ok)throw new Error(d.error||"Raid launch failed ("+r.status+")");closePay();toast(isFree?"Free raid launched — posted to @rugcxx":"Raid activated until "+new Date(d.endsAt).toLocaleString());loadCampaigns()}catch(e){const msg=e?.message||"Raid launch failed";status.textContent=msg;toast(msg)}}
async function payPremium(){if(!treasury){toast("Treasury wallet is not configured");return}try{const sig=await transfer(150000000,treasury);if(!sig)return;const r=await fetch("/api/premium/activate",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({walletAddress:walletAddress,signature:sig})});const d=await r.json();if(!d.ok)throw new Error(d.error||"Premium activation failed");closePremium();document.getElementById("premiumResult").textContent="Premium active until "+new Date(d.expiresAt).toLocaleString();toast("Premium Operator activated")}catch(e){toast(e.message||"Premium activation failed")}}



// Explicit button bindings: do not rely on inline onclick handlers.
document.getElementById("manageConnectWallet")?.addEventListener("click",async()=>{const a=await connect();if(a)await loadMyCampaigns()});
document.getElementById("manageRefresh")?.addEventListener("click",loadMyCampaigns);
document.getElementById("saveCampaignEdit")?.addEventListener("click",saveCampaignEdit);
document.getElementById("cancelCampaignEdit")?.addEventListener("click",closeCampaignEditor);
document.getElementById("launchFreeRaid")?.addEventListener("click",()=>openPay("FREE RAID",0));
document.getElementById("launchFeatured")?.addEventListener("click",()=>openPay("FEATURED",0.02));
document.getElementById("launchMega")?.addEventListener("click",()=>openPay("MEGA RAID",0.05));
document.getElementById("launchFrontRow")?.addEventListener("click",()=>openPay("FRONT ROW",0.10));
document.getElementById("openPremiumButton")?.addEventListener("click",openPremium);
document.getElementById("closePayButton")?.addEventListener("click",closePay);
document.getElementById("payCampaignButton")?.addEventListener("click",payCampaign);
document.getElementById("closePremiumButton")?.addEventListener("click",closePremium);
document.getElementById("payPremiumButton")?.addEventListener("click",payPremium);
window.addEventListener("error",e=>{console.error("RUGCIRCUS page error",e.error||e.message)});
window.addEventListener("unhandledrejection",e=>{console.error("RUGCIRCUS request error",e.reason)});
(async()=>{
  const tgApp=telegramWebApp();
  if(tgApp){
    try{
      tgApp.ready();
      tgApp.expand();
      
      telegramInitData=tgApp.initData||telegramInitData;
      telegramUser=tgApp.initDataUnsafe?.user||telegramUser;
      if(telegramInitData)localStorage.setItem("rugcircus_telegram_init_data",telegramInitData);
    }catch(e){console.warn("Telegram Mini App init failed",e)}
  }else if(detectPhantom()){
    walletProvider=detectPhantom();
    try{
      const r=await walletProvider.connect({onlyIfTrusted:true});
      if(r?.publicKey){
        walletAddress=r.publicKey.toString();
        localStorage.setItem("rugcircus_wallet",walletAddress);
      }
    }catch{}
    const hint=document.getElementById("walletHint");
    if(hint&&walletAddress)hint.textContent="PHANTOM CONNECTED · "+walletAddress.slice(0,4)+"…"+walletAddress.slice(-4);
  }
  await config();
  restoreLeaderboardForm();
  await Promise.allSettled([loadCampaigns(),loadAnalytics(),loadRewards()]);
})();
