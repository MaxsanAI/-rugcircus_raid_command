<script>
const PUMP="https://pump.fun/coin/3wLrSM5gkSSSQGoivnnN32Xh6ffjDwFeJFMqnNnSpump";
const FREE_USER_KEY="rugcircus_free_user_id";
const LEADERBOARD_TOKEN_KEY="rugcircus_leaderboard_token";
function freeUserId(){let id=localStorage.getItem(FREE_USER_KEY);if(!id){id=Date.now().toString(36)+"_"+Math.random().toString(36).slice(2);localStorage.setItem(FREE_USER_KEY,id)}return id}
const TG="https://t.me/rugcxx";
const X="https://x.com/RugCircusX";
const pages=["home","explore","create","premium","movers","analytics","leaderboard","manage"];
let walletAddress=localStorage.getItem("rugcircus_ton_wallet")||localStorage.getItem("rugcircus_leaderboard_wallet")||"",tonConnectUI=null,tonTreasury="",premiumOperator=false,adsgramBlockId="",adsgramController=null,pay={name:"FEATURED",amount:0.75};
function initTonConnect(){if(tonConnectUI||!window.TON_CONNECT_UI?.TonConnectUI)return !!tonConnectUI;try{tonConnectUI=new window.TON_CONNECT_UI.TonConnectUI({manifestUrl:"https://raidrugcircus.pulserapp.com/tonconnect-manifest.json",buttonRootId:null,language:"en",uiPreferences:{theme:"DARK"}});tonConnectUI.onStatusChange(wallet=>{walletAddress=String(wallet?.account?.address||"");if(walletAddress)localStorage.setItem("rugcircus_ton_wallet",walletAddress);else localStorage.removeItem("rugcircus_ton_wallet");updateLeaderboardIdentity();config()},err=>console.warn("TON Connect status error",err));return true}catch(e){console.error("TON Connect init failed",e);return false}}
async function connectTon(){if(!tonConnectUI&&!initTonConnect()){toast("TON Wallet could not be loaded.");return null}if(tonConnectUI.connected&&walletAddress)return walletAddress;try{await tonConnectUI.openModal();await tonConnectUI.connectionRestored;return walletAddress||String(tonConnectUI.account?.address||"")||null}catch{toast("Wallet connection cancelled");return null}}
async function disconnectTon(){try{await tonConnectUI?.disconnect()}catch{}walletAddress="";localStorage.removeItem("rugcircus_ton_wallet");updateLeaderboardIdentity();toast("Telegram Wallet disconnected")}

function showPage(p){if(!pages.includes(p))p="home";pages.forEach(x=>document.getElementById("page-"+x).classList.toggle("active",x===p));document.querySelectorAll(".nav button").forEach(b=>b.classList.toggle("active",b.dataset.page===p));if(p==="analytics")loadAnalytics();if(p==="leaderboard")loadRewards();if(p==="manage")loadMyCampaigns();document.getElementById("nav")?.classList.remove("open");document.getElementById("menuToggle")?.setAttribute("aria-expanded","false");window.scrollTo({top:0,behavior:"smooth"})}
document.getElementById("menuToggle")?.addEventListener("click",()=>{const nav=document.getElementById("nav");if(!nav)return;const open=!nav.classList.contains("open");nav.classList.toggle("open",open);document.getElementById("menuToggle").setAttribute("aria-expanded",String(open));document.getElementById("menuToggle").setAttribute("aria-label",open?"Close menu":"Open menu")});
document.querySelectorAll("[data-page]").forEach(b=>b.addEventListener("click",()=>showPage(b.dataset.page)));document.getElementById("leaderboardNavButton")?.addEventListener("click",()=>window.location.assign("/leaderboard"));
document.getElementById("walletHint")?.addEventListener("click",async()=>{await connectTelegram()});
document.querySelectorAll("[data-page-link]").forEach(b=>b.addEventListener("click",()=>showPage(b.dataset.pageLink)));document.getElementById("connectTelegramButton")?.addEventListener("click",connectTelegram);document.getElementById("connectLeaderboardTonButton")?.addEventListener("click",connectLeaderboardTon);document.getElementById("joinLeaderboardButton")?.addEventListener("click",joinLeaderboard);document.getElementById("leaderUsername")?.addEventListener("input",()=>{if(!telegramUser){leaderboardIdentity=document.getElementById("leaderUsername").value.trim().replace(/^@/,"");updateLeaderboardIdentity()}});
