function openPay(name,amount){pay={name,amount};document.getElementById("payTitle").textContent=name;document.getElementById("payAmount").textContent=amount.toFixed(2)+" GRAM";document.getElementById("payStatus").textContent=Number(amount)===0?"No wallet required. The raid will be posted automatically to @rugcxx.":"TON Wallet will show the exact GRAM amount and treasury recipient before you approve.";document.getElementById("payModal").classList.add("open")}
function closePay(){document.getElementById("payModal").classList.remove("open")}function openPremium(){document.getElementById("premiumModal").classList.add("open")}function closePremium(){document.getElementById("premiumModal").classList.remove("open")}
async function payCampaign(){const status=document.getElementById("payStatus");try{const mintAddress=document.getElementById("ca").value.trim(),telegramGroup=document.getElementById("tgGroup").value.trim();if(!mintAddress||!telegramGroup)return;const isFree=Number(pay.amount)===0;status.textContent=isFree?"Launching free raid…":"Connecting TON Wallet…";const body={package:pay.name,mintAddress,ticker:document.getElementById("ticker").value.trim(),name:document.getElementById("tokenName").value.trim(),xUrl:document.getElementById("xUrl").value.trim(),imageUrl:document.getElementById("imageUrl").value.trim(),tiktokUrl:document.getElementById("ttUrl").value.trim(),telegramUrl:document.getElementById("tgUrl").value.trim(),telegramGroup,pumpCalloutUrl:document.getElementById("calloutUrl").value.trim(),raidCopy:document.getElementById("raidCopy").value.trim(),clientId:freeUserId(),telegramInitData:telegramInitData||telegramWebApp()?.initData||""};let endpoint="/api/campaign/free";if(!isFree){endpoint="/api/campaign/create";const address=await connectTon();if(!address)return;body.payerWallet=address;body.tonTreasury=tonTreasury;if(!body.tonTreasury){status.textContent="TON treasury wallet is not configured.";return}const payment=await sendTonPayment(Math.round(pay.amount*1e9),body.tonTreasury);if(!payment)return;body.boc=payment.boc}const r=await fetch(endpoint,{method:"POST",headers:{"content-type":"application/json","x-telegram-init-data":telegramInitData||telegramWebApp()?.initData||""},body:JSON.stringify(body)});const d=await r.json().catch(()=>({}));if(!r.ok||!d.ok)throw new Error(d.error||"Raid launch failed");closePay();toast(isFree?"Free raid launched — posted to @rugcxx":"Raid activated until "+new Date(d.endsAt).toLocaleString());loadCampaigns()}catch(e){status.textContent=e?.message||"Raid launch failed";toast(status.textContent)}}
async function payPremium(){if(!tonTreasury){toast("TON treasury wallet is not configured");return}try{const payment=await sendTonPayment(6000000000,tonTreasury);if(!payment)return;const r=await fetch("/api/premium/activate",{method:"POST",headers:{"content-type":"application/json","x-telegram-init-data":telegramInitData||telegramWebApp()?.initData||""},body:JSON.stringify({walletAddress,boc:payment.boc,telegramInitData:telegramInitData||telegramWebApp()?.initData||""})});const d=await r.json();if(!d.ok)throw new Error(d.error||"Premium activation failed");closePremium();document.getElementById("premiumResult").textContent="Premium active until "+new Date(d.expiresAt).toLocaleString();toast("Premium Operator activated")}catch(e){toast(e.message||"Premium activation failed")}}




document.getElementById("whatsappSupportButton")?.addEventListener("click",()=>{window.location.href="/api/contact/whatsapp"});
// Explicit button bindings: do not rely on inline onclick handlers.
document.getElementById("manageConnectWallet")?.addEventListener("click",async()=>{const a=await connectTon();if(a)await loadMyCampaigns()});
document.getElementById("manageRefresh")?.addEventListener("click",loadMyCampaigns);
document.getElementById("saveCampaignEdit")?.addEventListener("click",saveCampaignEdit);
document.getElementById("cancelCampaignEdit")?.addEventListener("click",closeCampaignEditor);
document.getElementById("launchFreeRaid")?.addEventListener("click",()=>openPay("FREE RAID",0));
document.getElementById("launchFeatured")?.addEventListener("click",()=>openPay("FEATURED",0.75));
document.getElementById("launchMega")?.addEventListener("click",()=>openPay("MEGA RAID",2));
document.getElementById("launchFrontRow")?.addEventListener("click",()=>openPay("FRONT ROW",4));
document.getElementById("openPremiumButton")?.addEventListener("click",openPremium);
document.getElementById("closePayButton")?.addEventListener("click",closePay);
document.getElementById("payCampaignButton")?.addEventListener("click",payCampaign);
document.getElementById("closePremiumButton")?.addEventListener("click",closePremium);
document.getElementById("payPremiumButton")?.addEventListener("click",payPremium);
window.addEventListener("error",e=>{console.error("RUGCIRCUS page error",e.error||e.message)});
window.addEventListener("unhandledrejection",e=>{console.error("RUGCIRCUS request error",e.reason)});

function runRugcircusBackground(task,label){
  const run=()=>Promise.resolve().then(task).catch(e=>console.warn("RUGCIRCUS background task failed:",label,e));
  if(typeof window.requestIdleCallback==="function"){
    window.requestIdleCallback(run,{timeout:2500});
  }else{
    window.setTimeout(run,120);
  }
}

(async()=>{
  if(window.__RUGCIRCUS_MINIAPP_BOOTED)return;
  window.__RUGCIRCUS_MINIAPP_BOOTED=true;

  const tgApp=telegramWebApp();
  if(tgApp){
    try{
      tgApp.ready();
      telegramInitData=tgApp.initData||telegramInitData;
      telegramUser=tgApp.initDataUnsafe?.user||telegramUser;
      if(telegramInitData)localStorage.setItem("rugcircus_telegram_init_data",telegramInitData);

      window.setTimeout(()=>{
        try{
          if(!tgApp.isExpanded)tgApp.expand();
        }catch(e){console.warn("Telegram Mini App expand failed",e)}
      },0);
    }catch(e){console.warn("Telegram Mini App init failed",e)}
  }else{
    initTonConnect();
  }

  restoreLeaderboardForm();

  // Campaigns are the only network-heavy task needed immediately for the visible home screen.
  // Everything else starts after the Mini App is already interactive.
  try{
    await loadCampaigns();
  }catch(e){
    console.warn("RUGCIRCUS campaign boot failed",e);
  }

  runRugcircusBackground(()=>initTonConnect(),"TON Connect initialization");
  runRugcircusBackground(config,"remote config");
  runRugcircusBackground(loadAnalytics,"analytics");
  runRugcircusBackground(loadRewards,"rewards");
})();
</script>
