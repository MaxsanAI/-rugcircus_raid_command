<title>RUGCIRCUS COMMAND</title>
<style>
:root{color-scheme:dark;--bg:#09070f;--panel:#11101a;--panel2:#171421;--line:#2a2437;--text:#f6f1ff;--muted:#a59bb7;--hot:#ff4d8d;--gold:#ffc857;--violet:#9b7cff;--green:#55e6a5;--cyan:#55d8ff}*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,select{font:inherit}button{cursor:pointer}.app{min-height:100vh;background:radial-gradient(circle at 15% -5%,rgba(155,124,255,.22),transparent 32%),radial-gradient(circle at 90% 10%,rgba(255,77,141,.16),transparent 30%),linear-gradient(145deg,#09070f,#0d0a15 55%,#09070f)}.top{height:72px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;background:rgba(9,7,15,.86);backdrop-filter:blur(18px);z-index:20}.brand{display:flex;align-items:center;gap:12px;font-weight:900;letter-spacing:.04em}.logo{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;background:linear-gradient(135deg,var(--hot),var(--violet));box-shadow:0 0 30px rgba(255,77,141,.25)}.brand small{display:block;color:var(--muted);font-size:9px;letter-spacing:.18em}.nav{display:flex;gap:5px}.nav button,.wallet{border:1px solid transparent;background:transparent;color:var(--muted);padding:9px 12px;border-radius:10px}.nav button.active,.nav button:hover{color:var(--text);background:var(--panel2);border-color:var(--line)}.wallet{color:#fff;border-color:#3b334c;background:linear-gradient(135deg,#171221,#21182b)}.wrap{max-width:1420px;margin:auto;padding:28px}.hero{display:grid;grid-template-columns:1.35fr .65fr;gap:18px;margin-bottom:18px}.heroCard,.panel{background:linear-gradient(145deg,rgba(23,20,33,.95),rgba(13,11,20,.95));border:1px solid var(--line);border-radius:20px;box-shadow:0 18px 60px rgba(0,0,0,.22)}.heroCard{padding:32px;position:relative;overflow:hidden}.heroCard:after{content:"";position:absolute;width:330px;height:330px;border-radius:50%;right:-130px;top:-160px;background:radial-gradient(circle,rgba(255,77,141,.3),transparent 65%)}.eyebrow{color:var(--gold);font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}.hero h1{font-size:clamp(38px,5vw,72px);line-height:.9;margin:15px 0 14px;letter-spacing:-.055em}.hero h1 span{background:linear-gradient(90deg,#fff,var(--hot),var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent}.hero p{max-width:680px;color:var(--muted);font-size:16px;line-height:1.65}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.primary,.secondary{padding:12px 16px;border-radius:12px;border:1px solid var(--line);font-weight:800}.primary{background:linear-gradient(135deg,var(--hot),#8e59ff);color:white}.secondary{background:#15121e;color:var(--text)}.metrics{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.metric{padding:18px;border:1px solid var(--line);border-radius:16px;background:rgba(17,16,26,.8)}.metric b{display:block;font-size:24px}.metric span{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.12em}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.panel{padding:20px}.panelHead{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}.panel h2{font-size:15px;margin:0}.muted{color:var(--muted)}.tag{font-size:10px;border:1px solid var(--line);padding:5px 8px;border-radius:999px;color:var(--muted)}.tokens{display:grid;gap:9px}.token{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center;padding:12px;border:1px solid var(--line);background:#12101a;border-radius:14px}.coin{width:38px;height:38px;border-radius:12px;display:grid;place-items:center;font-weight:900;background:linear-gradient(135deg,#2b203b,#d53b78)}.token b{font-size:14px}.token small{display:block;color:var(--muted);margin-top:3px}.score{color:var(--green);font-weight:800;font-size:12px}.social{display:grid;gap:10px}.post{border:1px solid var(--line);background:#0f0d15;border-radius:15px;padding:14px}.postTop{display:flex;justify-content:space-between;gap:10px}.postTop b{font-size:12px}.postTop span{font-size:10px;color:var(--muted)}.post p{margin:9px 0;color:#d9d2e3;line-height:1.45;font-size:13px}.postActions{display:flex;gap:8px;flex-wrap:wrap}.tiny{font-size:10px;color:var(--muted);border:1px solid var(--line);padding:5px 8px;border-radius:8px;background:#15121d}.sponsor{margin:18px 0;border:1px dashed #5a4264;background:linear-gradient(135deg,rgba(255,77,141,.08),rgba(155,124,255,.07));border-radius:16px;padding:14px;display:flex;justify-content:space-between;align-items:center;gap:15px}.sponsor b{display:block;font-size:12px}.sponsor span{font-size:11px;color:var(--muted)}.sponsor a{color:white;text-decoration:none;background:#261c32;border:1px solid #46334e;padding:9px 12px;border-radius:9px;font-size:11px;font-weight:800}.raid{border:1px solid #40334f;background:linear-gradient(135deg,#161020,#0f0c15);border-radius:18px;padding:18px}.raidTitle{display:flex;justify-content:space-between;align-items:start}.live{color:var(--green);font-size:10px;font-weight:900}.raid h3{margin:5px 0;font-size:20px}.bar{height:7px;background:#25202f;border-radius:99px;overflow:hidden;margin:14px 0}.bar i{display:block;width:82%;height:100%;background:linear-gradient(90deg,var(--hot),var(--gold));border-radius:99px}.raidBtns{display:flex;gap:8px;flex-wrap:wrap}.raidBtns button{flex:1;min-width:110px}.table{display:grid;gap:7px}.row{display:grid;grid-template-columns:30px 1fr auto;gap:10px;align-items:center;padding:10px;border-bottom:1px solid #201c28;font-size:12px}.rank{color:var(--gold);font-weight:900}.page{display:none}.page.active{display:block}.form{display:grid;gap:12px}.form label{font-size:11px;color:var(--muted)}.form input,.form select{width:100%;background:#0e0c14;border:1px solid var(--line);color:var(--text);border-radius:11px;padding:12px;outline:none}.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.plan{padding:16px;border:1px solid var(--line);border-radius:14px;background:#12101a}.plan.featured{border-color:#8e59ff;box-shadow:0 0 25px rgba(142,89,255,.12)}.plan b{font-size:14px}.plan strong{display:block;font-size:22px;margin:8px 0}.plan p{font-size:11px;color:var(--muted);min-height:35px}.plan button{width:100%}.modal{position:fixed;inset:0;background:rgba(0,0,0,.7);display:none;align-items:center;justify-content:center;padding:20px;z-index:50}.modal.open{display:flex}.modalBox{width:min(470px,100%);background:#14111d;border:1px solid var(--line);border-radius:20px;padding:22px;box-shadow:0 30px 100px #000}.close{float:right;background:none;border:0;color:var(--muted);font-size:20px}.toast{position:fixed;right:20px;bottom:20px;background:#191522;border:1px solid var(--line);padding:13px 16px;border-radius:12px;display:none;z-index:60}.toast.show{display:block}@media(max-width:900px){.hero,.grid{grid-template-columns:1fr}.nav{display:none}.top{padding:0 16px}.wrap{padding:16px}.heroCard{padding:23px}.plans{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.hero h1{font-size:43px}.token{grid-template-columns:auto 1fr}.token .score{grid-column:2}.sponsor{align-items:flex-start;flex-direction:column}.sponsor a{width:100%;text-align:center}}
</style>
<script src="https://unpkg.com/@solana/web3.js@1.98.4/lib/index.iife.min.js"></script>
</head>
<body>
<div class="app">
<header class="top"><div class="brand"><div class="logo">🎪</div><div>RUGCIRCUS<small>COMMAND</small></div></div><nav class="nav"><button class="active" data-page="home">Command</button><button data-page="explore">Explore</button><button data-page="create">Create Raid</button><button data-page="leaderboard">Leaderboard</button></nav><button class="wallet" id="wallet">Connect Wallet</button></header>
