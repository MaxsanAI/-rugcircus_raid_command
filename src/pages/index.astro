function watchLeaderboardViews(){const cards=document.querySelectorAll(".token[data-campaign-id],.raid[data-campaign-id]");if(!cards.length)return;const observer=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){recordLeaderboardView(Number(entry.target.dataset.campaignId));observer.unobserve(entry.target)}})},{threshold:.35});cards.forEach(card=>observer.observe(card))}
